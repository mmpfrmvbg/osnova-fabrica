модуль Кодоген

// Этап 4 self-hosting: кодоген выражения (AST → байткод) на самой Основе.
// Генерирует OsVbcModule (JSON) для выражения из чисел и бинарных операций.

процедура опкод(оп)
  если оп == "+"
    вернуть "add"
  конец
  если оп == "-"
    вернуть "sub"
  конец
  если оп == "*"
    вернуть "mul"
  конец
  если оп == "/"
    вернуть "div"
  конец
  вернуть "add"
конец

процедура добавить_константу(константы, значение)
  пусть i = 0
  пока i < система.массив.длина(константы)
    если константы[i] == значение
      вернуть i
    конец
    i = i + 1
  конец
  система.массив.добавить(константы, значение)
  вернуть система.массив.длина(константы) - 1
конец

процедура код_выражения(аст, константы, код)
  если аст.вид == "число"
    пусть k = добавить_константу(константы, аст.значение)
    пусть инстр = { op: "const" }
    система.объект.установить(инстр, "type", "i32")
    система.объект.установить(инстр, "k", k)
    система.массив.добавить(код, инстр)
    вернуть
  конец
  если аст.вид == "бинарное"
    код_выражения(аст.левое, константы, код)
    код_выражения(аст.правое, константы, код)
    система.массив.добавить(код, { op: опкод(аст.оп) })
    вернуть
  конец
конец

процедура главная()
  // AST: (+ 1 (* 2 3)) = 7
  пусть аст = { вид: "бинарное", оп: "+", левое: { вид: "число", значение: 1 }, правое: { вид: "бинарное", оп: "*", левое: { вид: "число", значение: 2 }, правое: { вид: "число", значение: 3 } } }
  пусть константы = []
  пусть код = []
  код_выражения(аст, константы, код)
  система.массив.добавить(код, { op: "ret" })
  пусть процедуры = [ { name: "главная", codeOffset: 0, argc: 0, localsCount: 0 } ]
  пусть байткод = { version: 1, moduleName: "Кодоген", constants: константы, procedures: процедуры, code: код }
  система.лог.вывести(система.json.создать(байткод))
  вернуть 0
конец

конец

модуль Лексер

// Этап 5 self-hosting: полный лексер (строки, переносы, числа, имена, операторы).

процедура является_буквой(с)
  если с == ""
    вернуть ложь
  конец
  если (с >= "a") и (с <= "z")
    вернуть истина
  конец
  если (с >= "A") и (с <= "Z")
    вернуть истина
  конец
  если (с >= "а") и (с <= "я")
    вернуть истина
  конец
  если (с >= "А") и (с <= "Я")
    вернуть истина
  конец
  если с == "ё"
    вернуть истина
  конец
  если с == "Ё"
    вернуть истина
  конец
  вернуть ложь
конец

процедура является_цифрой(с)
  если с == ""
    вернуть ложь
  конец
  если (с >= "0") и (с <= "9")
    вернуть истина
  конец
  вернуть ложь
конец

процедура вид_имени(имя)
  если имя == "пусть"
    вернуть "пусть"
  конец
  если имя == "если"
    вернуть "если"
  конец
  если имя == "иначе"
    вернуть "иначе"
  конец
  если имя == "пока"
    вернуть "пока"
  конец
  если имя == "вернуть"
    вернуть "вернуть"
  конец
  если имя == "конец"
    вернуть "конец"
  конец
  если имя == "модуль"
    вернуть "модуль"
  конец
  если имя == "процедура"
    вернуть "процедура"
  конец
  если имя == "истина"
    вернуть "истина"
  конец
  если имя == "ложь"
    вернуть "ложь"
  конец
  вернуть "идентификатор"
конец

процедура лексер(источник)
  пусть токены = []
  пусть i = 0
  пусть длина = система.строка.длина(источник)
  пока i < длина
    пусть с = система.строка.подстрока(источник, i, i + 1)
    если с == " "
      i = i + 1
      продолжить
    конец
    если с == "\n"
      система.массив.добавить(токены, { вид: "новая_строка", текст: "" })
      i = i + 1
      продолжить
    конец
    если с == "\""
      i = i + 1
      пусть значение = ""
      пока (i < длина) и (система.строка.подстрока(источник, i, i + 1) != "\"")
        значение = значение + система.строка.подстрока(источник, i, i + 1)
        i = i + 1
      конец
      i = i + 1
      система.массив.добавить(токены, { вид: "строка", текст: значение })
      продолжить
    конец
    если является_цифрой(с)
      пусть число = ""
      пока (i < длина) и является_цифрой(система.строка.подстрока(источник, i, i + 1))
        число = число + система.строка.подстрока(источник, i, i + 1)
        i = i + 1
      конец
      система.массив.добавить(токены, { вид: "число", текст: число })
      продолжить
    конец
    если является_буквой(с) или с == "_"
      пусть имя = ""
      пока (i < длина) и (является_буквой(система.строка.подстрока(источник, i, i + 1)) или является_цифрой(система.строка.подстрока(источник, i, i + 1)) или система.строка.подстрока(источник, i, i + 1) == "_")
        имя = имя + система.строка.подстрока(источник, i, i + 1)
        i = i + 1
      конец
      система.массив.добавить(токены, { вид: вид_имени(имя), текст: имя })
      продолжить
    конец
    если с == "="
      если система.строка.подстрока(источник, i + 1, i + 2) == "="
        система.массив.добавить(токены, { вид: "==", текст: "==" })
        i = i + 2
      иначе
        система.массив.добавить(токены, { вид: "=", текст: "=" })
        i = i + 1
      конец
      продолжить
    конец
    если с == "+"
      система.массив.добавить(токены, { вид: "+", текст: "+" })
      i = i + 1
      продолжить
    конец
    если с == "-"
      система.массив.добавить(токены, { вид: "-", текст: "-" })
      i = i + 1
      продолжить
    конец
    если с == "*"
      система.массив.добавить(токены, { вид: "*", текст: "*" })
      i = i + 1
      продолжить
    конец
    если с == "/"
      система.массив.добавить(токены, { вид: "/", текст: "/" })
      i = i + 1
      продолжить
    конец
    если с == "("
      система.массив.добавить(токены, { вид: "(", текст: "(" })
      i = i + 1
      продолжить
    конец
    если с == ")"
      система.массив.добавить(токены, { вид: ")", текст: ")" })
      i = i + 1
      продолжить
    конец
    если с == "["
      система.массив.добавить(токены, { вид: "[", текст: "[" })
      i = i + 1
      продолжить
    конец
    если с == "]"
      система.массив.добавить(токены, { вид: "]", текст: "]" })
      i = i + 1
      продолжить
    конец
    если с == "{"
      система.массив.добавить(токены, { вид: "{", текст: "{" })
      i = i + 1
      продолжить
    конец
    если с == "}"
      система.массив.добавить(токены, { вид: "}", текст: "}" })
      i = i + 1
      продолжить
    конец
    если с == ":"
      система.массив.добавить(токены, { вид: ":", текст: ":" })
      i = i + 1
      продолжить
    конец
    если с == ","
      система.массив.добавить(токены, { вид: ",", текст: "," })
      i = i + 1
      продолжить
    конец
    если с == "<"
      если система.строка.подстрока(источник, i + 1, i + 2) == "="
        система.массив.добавить(токены, { вид: "<=", текст: "<=" })
        i = i + 2
      иначе
        система.массив.добавить(токены, { вид: "<", текст: "<" })
        i = i + 1
      конец
      продолжить
    конец
    если с == ">"
      если система.строка.подстрока(источник, i + 1, i + 2) == "="
        система.массив.добавить(токены, { вид: ">=", текст: ">=" })
        i = i + 2
      иначе
        система.массив.добавить(токены, { вид: ">", текст: ">" })
        i = i + 1
      конец
      продолжить
    конец
    i = i + 1
  конец
  система.массив.добавить(токены, { вид: "конец_файла", текст: "" })
  вернуть токены
конец

процедура главная()
  пусть код = "пусть x = \"привет\"\nпусть y = 1 + 2"
  пусть токены = лексер(код)
  пусть k = 0
  пока k < система.массив.длина(токены)
    система.лог.вывести(токены[k].вид + "|" + токены[k].текст)
    k = k + 1
  конец
  вернуть 0
конец

конец

модуль Интерпретатор

// Этап 1 self-hosting: интерпретатор подмножества Основы на самой Основе.
// Добавлены: имя (переменная), пусть, присвоить, последовательность, пока.
// Окружение — мутабельный объект имя → значение.

процедура вычислить(узел, окружение)
  если узел.вид == "число"
    вернуть узел.значение
  конец
  если узел.вид == "имя"
    вернуть система.объект.получить(окружение, узел.имя)
  конец
  если узел.вид == "сложение"
    вернуть вычислить(узел.левое, окружение) + вычислить(узел.правое, окружение)
  конец
  если узел.вид == "умножение"
    вернуть вычислить(узел.левое, окружение) * вычислить(узел.правое, окружение)
  конец
  если узел.вид == "меньше"
    если вычислить(узел.левое, окружение) < вычислить(узел.правое, окружение)
      вернуть 1
    конец
    вернуть 0
  конец
  если узел.вид == "пусть"
    система.объект.установить(окружение, узел.имя, вычислить(узел.значение, окружение))
    вернуть вычислить(узел.тело, окружение)
  конец
  если узел.вид == "присвоить"
    система.объект.установить(окружение, узел.имя, вычислить(узел.значение, окружение))
    вернуть 0
  конец
  если узел.вид == "последовательность"
    пусть i = 0
    пусть результат = 0
    пока i < система.массив.длина(узел.шаги)
      результат = вычислить(узел.шаги[i], окружение)
      i = i + 1
    конец
    вернуть результат
  конец
  если узел.вид == "пока"
    пока вычислить(узел.условие, окружение) != 0
      вычислить(узел.тело, окружение)
    конец
    вернуть 0
  конец
  вернуть 0
конец

процедура главная()
  пусть окружение = {}
  // сумма = 0; i = 1; пока i < 6: сумма += i; i += 1 → 1+2+3+4+5 = 15
  пусть программа = { вид: "последовательность", шаги: [ { вид: "пусть", имя: "i", значение: { вид: "число", значение: 1 }, тело: { вид: "пусть", имя: "сумма", значение: { вид: "число", значение: 0 }, тело: { вид: "пока", условие: { вид: "меньше", левое: { вид: "имя", имя: "i" }, правое: { вид: "число", значение: 6 } }, тело: { вид: "последовательность", шаги: [ { вид: "присвоить", имя: "сумма", значение: { вид: "сложение", левое: { вид: "имя", имя: "сумма" }, правое: { вид: "имя", имя: "i" } } }, { вид: "присвоить", имя: "i", значение: { вид: "сложение", левое: { вид: "имя", имя: "i" }, правое: { вид: "число", значение: 1 } } } ] } } } }, { вид: "имя", имя: "сумма" } ] }
  вернуть вычислить(программа, окружение)
конец

конец

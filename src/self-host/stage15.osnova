модуль Компилятор

// Этап 7 self-hosting: единый конвейер — модуль, процедуры, вызовы.
// Исходник (модуль + процедуры) → токены → AST → байткод → JSON.

процедура является_буквой(с)
  если с == ""
    вернуть ложь
  конец
  если (с >= "a") и (с <= "z")
    вернуть истина
  конец
  если (с >= "A") и (с <= "Z")
    вернуть истина
  конец
  если (с >= "а") и (с <= "я")
    вернуть истина
  конец
  если (с >= "А") и (с <= "Я")
    вернуть истина
  конец
  если с == "ё"
    вернуть истина
  конец
  если с == "Ё"
    вернуть истина
  конец
  вернуть ложь
конец

процедура является_цифрой(с)
  если с == ""
    вернуть ложь
  конец
  если (с >= "0") и (с <= "9")
    вернуть истина
  конец
  вернуть ложь
конец

процедура вид_имени(имя)
  если имя == "пусть"
    вернуть "пусть"
  конец
  если имя == "если"
    вернуть "если"
  конец
  если имя == "иначе"
    вернуть "иначе"
  конец
  если имя == "пока"
    вернуть "пока"
  конец
  если имя == "вернуть"
    вернуть "вернуть"
  конец
  если имя == "конец"
    вернуть "конец"
  конец
  если имя == "модуль"
    вернуть "модуль"
  конец
  если имя == "процедура"
    вернуть "процедура"
  конец
  если имя == "истина"
    вернуть "истина"
  конец
  если имя == "ложь"
    вернуть "ложь"
  конец
  вернуть "идентификатор"
конец

процедура лексер(источник)
  пусть токены = []
  пусть i = 0
  пусть длина = система.строка.длина(источник)
  пока i < длина
    пусть с = система.строка.подстрока(источник, i, i + 1)
    если с == " "
      i = i + 1
      продолжить
    конец
    если с == "\n"
      система.массив.добавить(токены, { вид: "новая_строка", текст: "" })
      i = i + 1
      продолжить
    конец
    если с == "\""
      i = i + 1
      пусть значение = ""
      пока (i < длина) и (система.строка.подстрока(источник, i, i + 1) != "\"")
        значение = значение + система.строка.подстрока(источник, i, i + 1)
        i = i + 1
      конец
      i = i + 1
      система.массив.добавить(токены, { вид: "строка", текст: значение })
      продолжить
    конец
    если является_цифрой(с)
      пусть число = ""
      пока (i < длина) и является_цифрой(система.строка.подстрока(источник, i, i + 1))
        число = число + система.строка.подстрока(источник, i, i + 1)
        i = i + 1
      конец
      система.массив.добавить(токены, { вид: "число", текст: число })
      продолжить
    конец
    если является_буквой(с) или с == "_"
      пусть имя = ""
      пока (i < длина) и (является_буквой(система.строка.подстрока(источник, i, i + 1)) или является_цифрой(система.строка.подстрока(источник, i, i + 1)) или система.строка.подстрока(источник, i, i + 1) == "_")
        имя = имя + система.строка.подстрока(источник, i, i + 1)
        i = i + 1
      конец
      система.массив.добавить(токены, { вид: вид_имени(имя), текст: имя })
      продолжить
    конец
    если с == "="
      если система.строка.подстрока(источник, i + 1, i + 2) == "="
        система.массив.добавить(токены, { вид: "==", текст: "==" })
        i = i + 2
      иначе
        система.массив.добавить(токены, { вид: "=", текст: "=" })
        i = i + 1
      конец
      продолжить
    конец
    если с == "+"
      система.массив.добавить(токены, { вид: "+", текст: "+" })
      i = i + 1
      продолжить
    конец
    если с == "-"
      система.массив.добавить(токены, { вид: "-", текст: "-" })
      i = i + 1
      продолжить
    конец
    если с == "*"
      система.массив.добавить(токены, { вид: "*", текст: "*" })
      i = i + 1
      продолжить
    конец
    если с == "/"
      система.массив.добавить(токены, { вид: "/", текст: "/" })
      i = i + 1
      продолжить
    конец
    если с == "("
      система.массив.добавить(токены, { вид: "(", текст: "(" })
      i = i + 1
      продолжить
    конец
    если с == ")"
      система.массив.добавить(токены, { вид: ")", текст: ")" })
      i = i + 1
      продолжить
    конец
    если с == ","
      система.массив.добавить(токены, { вид: ",", текст: "," })
      i = i + 1
      продолжить
    конец
    если с == "."
      система.массив.добавить(токены, { вид: ".", текст: "." })
      i = i + 1
      продолжить
    конец
    если с == "<"
      если система.строка.подстрока(источник, i + 1, i + 2) == "="
        система.массив.добавить(токены, { вид: "<=", текст: "<=" })
        i = i + 2
      иначе
        система.массив.добавить(токены, { вид: "<", текст: "<" })
        i = i + 1
      конец
      продолжить
    конец
    если с == ">"
      если система.строка.подстрока(источник, i + 1, i + 2) == "="
        система.массив.добавить(токены, { вид: ">=", текст: ">=" })
        i = i + 2
      иначе
        система.массив.добавить(токены, { вид: ">", текст: ">" })
        i = i + 1
      конец
      продолжить
    конец
    i = i + 1
  конец
  система.массив.добавить(токены, { вид: "конец_файла", текст: "" })
  вернуть токены
конец

процедура вид_токена(токены, состояние)
  если состояние.позиция >= система.массив.длина(токены)
    вернуть "конец"
  конец
  вернуть токены[состояние.позиция].вид
конец

процедура текст_токена(токены, состояние)
  вернуть токены[состояние.позиция].текст
конец

процедура разобрать_множитель(токены, состояние)
  если вид_токена(токены, состояние) == "число"
    пусть значение = текст_токена(токены, состояние)
    состояние.позиция = состояние.позиция + 1
    вернуть { вид: "число", значение: значение }
  конец
  если вид_токена(токены, состояние) == "строка"
    пусть значение = текст_токена(токены, состояние)
    состояние.позиция = состояние.позиция + 1
    вернуть { вид: "строка", значение: значение }
  конец
  если вид_токена(токены, состояние) == "идентификатор"
    пусть имя = текст_токена(токены, состояние)
    состояние.позиция = состояние.позиция + 1
    пока вид_токена(токены, состояние) == "."
      состояние.позиция = состояние.позиция + 1
      имя = имя + "." + текст_токена(токены, состояние)
      состояние.позиция = состояние.позиция + 1
    конец
    если вид_токена(токены, состояние) == "("
      состояние.позиция = состояние.позиция + 1
      пусть аргументы = []
      пока вид_токена(токены, состояние) != ")"
        пусть арг = разобрать_выражение(токены, состояние)
        система.массив.добавить(аргументы, арг)
        если вид_токена(токены, состояние) == ","
          состояние.позиция = состояние.позиция + 1
        конец
      конец
      состояние.позиция = состояние.позиция + 1
      вернуть { вид: "вызов", имя: имя, аргументы: аргументы }
    конец
    вернуть { вид: "переменная", имя: имя }
  конец
  если вид_токена(токены, состояние) == "("
    состояние.позиция = состояние.позиция + 1
    пусть аст = разобрать_выражение(токены, состояние)
    состояние.позиция = состояние.позиция + 1
    вернуть аст
  конец
  вернуть { вид: "число", значение: "0" }
конец

процедура разобрать_слагаемое(токены, состояние)
  пусть левое = разобрать_множитель(токены, состояние)
  пока (вид_токена(токены, состояние) == "*") или (вид_токена(токены, состояние) == "/")
    пусть оп = текст_токена(токены, состояние)
    состояние.позиция = состояние.позиция + 1
    пусть правое = разобрать_множитель(токены, состояние)
    левое = { вид: "бинарное", оп: оп, левое: левое, правое: правое }
  конец
  вернуть левое
конец

процедура разобрать_сложение(токены, состояние)
  пусть левое = разобрать_слагаемое(токены, состояние)
  пока (вид_токена(токены, состояние) == "+") или (вид_токена(токены, состояние) == "-")
    пусть оп = текст_токена(токены, состояние)
    состояние.позиция = состояние.позиция + 1
    пусть правое = разобрать_слагаемое(токены, состояние)
    левое = { вид: "бинарное", оп: оп, левое: левое, правое: правое }
  конец
  вернуть левое
конец

процедура разобрать_сравнение(токены, состояние)
  пусть левое = разобрать_сложение(токены, состояние)
  пока (вид_токена(токены, состояние) == "==") или (вид_токена(токены, состояние) == "<") или (вид_токена(токены, состояние) == ">") или (вид_токена(токены, состояние) == "<=") или (вид_токена(токены, состояние) == ">=")
    пусть оп = текст_токена(токены, состояние)
    состояние.позиция = состояние.позиция + 1
    пусть правое = разобрать_сложение(токены, состояние)
    левое = { вид: "бинарное", оп: оп, левое: левое, правое: правое }
  конец
  вернуть левое
конец

процедура разобрать_выражение(токены, состояние)
  вернуть разобрать_сравнение(токены, состояние)
конец

процедура разобрать_блок(токены, состояние)
  пусть инструкции = []
  пока истина
    пока вид_токена(токены, состояние) == "новая_строка"
      состояние.позиция = состояние.позиция + 1
    конец
    если (вид_токена(токены, состояние) == "конец") или (вид_токена(токены, состояние) == "иначе") или (вид_токена(токены, состояние) == "конец_файла")
      прервать
    конец
    пусть инстр = разобрать_инструкцию(токены, состояние)
    система.массив.добавить(инструкции, инстр)
  конец
  вернуть инструкции
конец

процедура разобрать_инструкцию(токены, состояние)
  если вид_токена(токены, состояние) == "пусть"
    состояние.позиция = состояние.позиция + 1
    пусть имя = текст_токена(токены, состояние)
    состояние.позиция = состояние.позиция + 1
    состояние.позиция = состояние.позиция + 1
    пусть значение = разобрать_выражение(токены, состояние)
    вернуть { вид: "пусть", имя: имя, значение: значение }
  конец
  если вид_токена(токены, состояние) == "вернуть"
    состояние.позиция = состояние.позиция + 1
    пусть значение = разобрать_выражение(токены, состояние)
    вернуть { вид: "вернуть", значение: значение }
  конец
  если вид_токена(токены, состояние) == "если"
    состояние.позиция = состояние.позиция + 1
    пусть условие = разобрать_выражение(токены, состояние)
    пусть то_ветка = разобрать_блок(токены, состояние)
    пусть иначе_ветка = []
    если вид_токена(токены, состояние) == "иначе"
      состояние.позиция = состояние.позиция + 1
      иначе_ветка = разобрать_блок(токены, состояние)
    конец
    если вид_токена(токены, состояние) == "конец"
      состояние.позиция = состояние.позиция + 1
    конец
    вернуть { вид: "если", условие: условие, то: то_ветка, иначе_в: иначе_ветка }
  конец
  если вид_токена(токены, состояние) == "пока"
    состояние.позиция = состояние.позиция + 1
    пусть условие = разобрать_выражение(токены, состояние)
    пусть тело = разобрать_блок(токены, состояние)
    если вид_токена(токены, состояние) == "конец"
      состояние.позиция = состояние.позиция + 1
    конец
    вернуть { вид: "пока", условие: условие, тело: тело }
  конец
  если вид_токена(токены, состояние) == "идентификатор"
    пусть имя = текст_токена(токены, состояние)
    состояние.позиция = состояние.позиция + 1
    состояние.позиция = состояние.позиция + 1
    пусть значение = разобрать_выражение(токены, состояние)
    вернуть { вид: "присвоить", имя: имя, значение: значение }
  конец
  вернуть { вид: "вернуть", значение: { вид: "число", значение: "0" } }
конец

процедура разобрать_программу(токены, состояние)
  пока вид_токена(токены, состояние) == "новая_строка"
    состояние.позиция = состояние.позиция + 1
  конец
  если вид_токена(токены, состояние) == "модуль"
    состояние.позиция = состояние.позиция + 1
    состояние.позиция = состояние.позиция + 1
  конец
  пусть процедуры = []
  пока истина
    пока вид_токена(токены, состояние) == "новая_строка"
      состояние.позиция = состояние.позиция + 1
    конец
    если вид_токена(токены, состояние) != "процедура"
      прервать
    конец
    состояние.позиция = состояние.позиция + 1
    пусть имя = текст_токена(токены, состояние)
    состояние.позиция = состояние.позиция + 1
    пусть параметры = []
    если вид_токена(токены, состояние) == "("
      состояние.позиция = состояние.позиция + 1
      пока вид_токена(токены, состояние) != ")"
        если вид_токена(токены, состояние) == "идентификатор"
          система.массив.добавить(параметры, текст_токена(токены, состояние))
          состояние.позиция = состояние.позиция + 1
        иначе
          состояние.позиция = состояние.позиция + 1
        конец
      конец
      состояние.позиция = состояние.позиция + 1
    конец
    пусть тело = разобрать_блок(токены, состояние)
    если вид_токена(токены, состояние) == "конец"
      состояние.позиция = состояние.позиция + 1
    конец
    система.массив.добавить(процедуры, { имя: имя, параметры: параметры, тело: тело })
  конец
  вернуть процедуры
конец

процедура опкод(оп)
  если оп == "+"
    вернуть "add"
  конец
  если оп == "-"
    вернуть "sub"
  конец
  если оп == "*"
    вернуть "mul"
  конец
  если оп == "/"
    вернуть "div"
  конец
  если оп == "=="
    вернуть "eq"
  конец
  если оп == "<"
    вернуть "lt"
  конец
  если оп == ">"
    вернуть "gt"
  конец
  если оп == "<="
    вернуть "le"
  конец
  если оп == ">="
    вернуть "ge"
  конец
  вернуть "add"
конец

процедура добавить_константу(константы, значение)
  пусть i = 0
  пока i < система.массив.длина(константы)
    если константы[i] == значение
      вернуть i
    конец
    i = i + 1
  конец
  система.массив.добавить(константы, значение)
  вернуть система.массив.длина(константы) - 1
конец

процедура индекс_переменной(локальные, имя, счётчик)
  пусть инд = локальные[имя]
  если инд != пусто
    вернуть инд
  конец
  локальные[имя] = счётчик.значение
  счётчик.значение = счётчик.значение + 1
  вернуть локальные[имя]
конец

процедура код_выражения(аст, константы, код, локальные, счётчик, таблица)
  если аст.вид == "число"
    пусть число = система.оценить(аст.значение)
    пусть k = добавить_константу(константы, число)
    пусть инстр = { op: "const" }
    система.объект.установить(инстр, "type", "i32")
    система.объект.установить(инстр, "k", k)
    система.массив.добавить(код, инстр)
    вернуть
  конец
  если аст.вид == "строка"
    пусть k = добавить_константу(константы, аст.значение)
    пусть инстр2 = { op: "const" }
    система.объект.установить(инстр2, "type", "str")
    система.объект.установить(инстр2, "k", k)
    система.массив.добавить(код, инстр2)
    вернуть
  конец
  если аст.вид == "переменная"
    пусть инд = индекс_переменной(локальные, аст.имя, счётчик)
    система.массив.добавить(код, { op: "local.get", i: инд })
    вернуть
  конец
  если аст.вид == "бинарное"
    код_выражения(аст.левое, константы, код, локальные, счётчик, таблица)
    код_выражения(аст.правое, константы, код, локальные, счётчик, таблица)
    система.массив.добавить(код, { op: опкод(аст.оп) })
    вернуть
  конец
  если аст.вид == "вызов"
    пусть i = 0
    пока i < система.массив.длина(аст.аргументы)
      код_выражения(аст.аргументы[i], константы, код, локальные, счётчик, таблица)
      i = i + 1
    конец
    если система.строка.содержит(аст.имя, ".")
      система.массив.добавить(код, { op: "invoke", name: аст.имя })
    иначе
      пусть фи = таблица[аст.имя]
      система.массив.добавить(код, { op: "call", fi: фи })
    конец
    вернуть
  конец
конец

процедура код_блока(инструкции, константы, код, локальные, счётчик, таблица)
  пусть i = 0
  пока i < система.массив.длина(инструкции)
    код_инструкции(инструкции[i], константы, код, локальные, счётчик, таблица)
    i = i + 1
  конец
конец

процедура код_инструкции(инстр, константы, код, локальные, счётчик, таблица)
  если инстр.вид == "пусть"
    код_выражения(инстр.значение, константы, код, локальные, счётчик, таблица)
    пусть инд = индекс_переменной(локальные, инстр.имя, счётчик)
    система.массив.добавить(код, { op: "local.set", i: инд })
    вернуть
  конец
  если инстр.вид == "присвоить"
    код_выражения(инстр.значение, константы, код, локальные, счётчик, таблица)
    пусть инд = индекс_переменной(локальные, инстр.имя, счётчик)
    система.массив.добавить(код, { op: "local.set", i: инд })
    вернуть
  конец
  если инстр.вид == "вернуть"
    код_выражения(инстр.значение, константы, код, локальные, счётчик, таблица)
    система.массив.добавить(код, { op: "ret" })
    вернуть
  конец
  если инстр.вид == "пока"
    пусть начало = система.массив.длина(код)
    код_выражения(инстр.условие, константы, код, локальные, счётчик, таблица)
    пусть поз_jmp = система.массив.длина(код)
    система.массив.добавить(код, { op: "jmp_if_not", off: 0 })
    код_блока(инстр.тело, константы, код, локальные, счётчик, таблица)
    система.массив.добавить(код, { op: "jmp", off: начало })
    пусть поз_конца = система.массив.длина(код)
    код[поз_jmp] = { op: "jmp_if_not", off: поз_конца }
    вернуть
  конец
  если инстр.вид == "если"
    код_выражения(инстр.условие, константы, код, локальные, счётчик, таблица)
    пусть поз_jmp_иначе = система.массив.длина(код)
    система.массив.добавить(код, { op: "jmp_if_not", off: 0 })
    код_блока(инстр.то, константы, код, локальные, счётчик, таблица)
    пусть поз_jmp_конец = система.массив.длина(код)
    система.массив.добавить(код, { op: "jmp", off: 0 })
    пусть поз_иначе = система.массив.длина(код)
    код[поз_jmp_иначе] = { op: "jmp_if_not", off: поз_иначе }
    код_блока(инстр.иначе_в, константы, код, локальные, счётчик, таблица)
    пусть поз_конца = система.массив.длина(код)
    код[поз_jmp_конец] = { op: "jmp", off: поз_конца }
    вернуть
  конец
конец

процедура собрать_таблицу(программа, таблица)
  пусть i = 0
  пока i < система.массив.длина(программа)
    таблица[программа[i].имя] = i
    i = i + 1
  конец
конец

процедура код_процедуры(проц, константы, код, процедуры, таблица)
  пусть код_смещение = система.массив.длина(код)
  пусть локальные = {}
  пусть счётчик = { значение: 0 }
  пусть i = 0
  пока i < система.массив.длина(проц.параметры)
    локальные[проц.параметры[i]] = счётчик.значение
    счётчик.значение = счётчик.значение + 1
    i = i + 1
  конец
  код_блока(проц.тело, константы, код, локальные, счётчик, таблица)
  система.массив.добавить(процедуры, { name: проц.имя, codeOffset: код_смещение, argc: система.массив.длина(проц.параметры), localsCount: счётчик.значение })
конец

процедура код_программы(программа, константы, код, процедуры, таблица)
  собрать_таблицу(программа, таблица)
  пусть i = 0
  пока i < система.массив.длина(программа)
    код_процедуры(программа[i], константы, код, процедуры, таблица)
    i = i + 1
  конец
конец

процедура главная()
  пусть код_исходник = "модуль Тест\nпроцедура удвоить(x)\n  вернуть x * 2\nконец\nпроцедура главная()\n  вернуть удвоить(21)\nконец\nконец"
  пусть токены = лексер(код_исходник)
  пусть состояние = { позиция: 0 }
  пусть программа = разобрать_программу(токены, состояние)
  пусть константы = []
  пусть код = []
  пусть процедуры = []
  пусть таблица = {}
  код_программы(программа, константы, код, процедуры, таблица)
  пусть байткод = { version: 1, moduleName: "Тест", constants: константы, procedures: процедуры, code: код }
  система.лог.вывести(система.json.создать(байткод))
  вернуть 0
конец

конец

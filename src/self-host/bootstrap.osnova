модуль Интерпретатор

// Этап 0 self-hosting: интерпретатор подмножества Основы, написанный на самой Основе.
// Программа задаётся как вложенные объекты (AST): { вид: ..., ... }.
// Подмножество: число, сложение, умножение, меньше, если.

процедура вычислить(узел)
  если узел.вид == "число"
    вернуть узел.значение
  конец
  если узел.вид == "сложение"
    вернуть вычислить(узел.левое) + вычислить(узел.правое)
  конец
  если узел.вид == "умножение"
    вернуть вычислить(узел.левое) * вычислить(узел.правое)
  конец
  если узел.вид == "меньше"
    если вычислить(узел.левое) < вычислить(узел.правое)
      вернуть 1
    конец
    вернуть 0
  конец
  если узел.вид == "если"
    если вычислить(узел.условие) != 0
      вернуть вычислить(узел.тогда)
    конец
    вернуть вычислить(узел.иначе)
  конец
  вернуть 0
конец

процедура главная()
  // (1 + 2) * 3 + если(1 < 2, 10, 20) = 9 + 10 = 19
  пусть аст = { вид: "сложение", левое: { вид: "умножение", левое: { вид: "сложение", левое: { вид: "число", значение: 1 }, правое: { вид: "число", значение: 2 } }, правое: { вид: "число", значение: 3 } }, правое: { вид: "если", условие: { вид: "меньше", левое: { вид: "число", значение: 1 }, правое: { вид: "число", значение: 2 } }, тогда: { вид: "число", значение: 10 }, иначе: { вид: "число", значение: 20 } } }
  вернуть вычислить(аст)
конец

конец

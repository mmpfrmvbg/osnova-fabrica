модуль Кодоген

// Этап 4.2 self-hosting: кодоген с циклом пока и присвоением.
// jmp/jmp_if_not off — абсолютный индекс инструкции; backpatch смещений.

процедура опкод(оп)
  если оп == "+"
    вернуть "add"
  конец
  если оп == "-"
    вернуть "sub"
  конец
  если оп == "*"
    вернуть "mul"
  конец
  если оп == "/"
    вернуть "div"
  конец
  если оп == "=="
    вернуть "eq"
  конец
  если оп == "<"
    вернуть "lt"
  конец
  если оп == ">"
    вернуть "gt"
  конец
  если оп == "<="
    вернуть "le"
  конец
  если оп == ">="
    вернуть "ge"
  конец
  вернуть "add"
конец

процедура добавить_константу(константы, значение)
  пусть i = 0
  пока i < система.массив.длина(константы)
    если константы[i] == значение
      вернуть i
    конец
    i = i + 1
  конец
  система.массив.добавить(константы, значение)
  вернуть система.массив.длина(константы) - 1
конец

процедура индекс_переменной(локальные, имя, счётчик)
  пусть инд = локальные[имя]
  если инд != пусто
    вернуть инд
  конец
  локальные[имя] = счётчик.значение
  счётчик.значение = счётчик.значение + 1
  вернуть локальные[имя]
конец

процедура код_выражения(аст, константы, код, локальные, счётчик)
  если аст.вид == "число"
    пусть k = добавить_константу(константы, аст.значение)
    пусть инстр = { op: "const" }
    система.объект.установить(инстр, "type", "i32")
    система.объект.установить(инстр, "k", k)
    система.массив.добавить(код, инстр)
    вернуть
  конец
  если аст.вид == "переменная"
    пусть инд = индекс_переменной(локальные, аст.имя, счётчик)
    система.массив.добавить(код, { op: "local.get", i: инд })
    вернуть
  конец
  если аст.вид == "бинарное"
    код_выражения(аст.левое, константы, код, локальные, счётчик)
    код_выражения(аст.правое, константы, код, локальные, счётчик)
    система.массив.добавить(код, { op: опкод(аст.оп) })
    вернуть
  конец
конец

процедура код_блока(инструкции, константы, код, локальные, счётчик)
  пусть i = 0
  пока i < система.массив.длина(инструкции)
    код_инструкции(инструкции[i], константы, код, локальные, счётчик)
    i = i + 1
  конец
конец

процедура код_инструкции(инстр, константы, код, локальные, счётчик)
  если инстр.вид == "пусть"
    код_выражения(инстр.значение, константы, код, локальные, счётчик)
    пусть инд = индекс_переменной(локальные, инстр.имя, счётчик)
    система.массив.добавить(код, { op: "local.set", i: инд })
    вернуть
  конец
  если инстр.вид == "присвоить"
    код_выражения(инстр.значение, константы, код, локальные, счётчик)
    пусть инд = индекс_переменной(локальные, инстр.имя, счётчик)
    система.массив.добавить(код, { op: "local.set", i: инд })
    вернуть
  конец
  если инстр.вид == "вернуть"
    код_выражения(инстр.значение, константы, код, локальные, счётчик)
    система.массив.добавить(код, { op: "ret" })
    вернуть
  конец
  если инстр.вид == "пока"
    пусть начало = система.массив.длина(код)
    код_выражения(инстр.условие, константы, код, локальные, счётчик)
    пусть поз_jmp = система.массив.длина(код)
    система.массив.добавить(код, { op: "jmp_if_not", off: 0 })
    код_блока(инстр.тело, константы, код, локальные, счётчик)
    система.массив.добавить(код, { op: "jmp", off: начало })
    пусть поз_конца = система.массив.длина(код)
    код[поз_jmp] = { op: "jmp_if_not", off: поз_конца }
    вернуть
  конец
конец

процедура главная()
  // i = 0; s = 0; пока i < 3: s += i; i += 1 → 0+1+2 = 3
  пусть инструкции = [ { вид: "пусть", имя: "i", значение: { вид: "число", значение: 0 } }, { вид: "пусть", имя: "s", значение: { вид: "число", значение: 0 } }, { вид: "пока", условие: { вид: "бинарное", оп: "<", левое: { вид: "переменная", имя: "i" }, правое: { вид: "число", значение: 3 } }, тело: [ { вид: "присвоить", имя: "s", значение: { вид: "бинарное", оп: "+", левое: { вид: "переменная", имя: "s" }, правое: { вид: "переменная", имя: "i" } } }, { вид: "присвоить", имя: "i", значение: { вид: "бинарное", оп: "+", левое: { вид: "переменная", имя: "i" }, правое: { вид: "число", значение: 1 } } } ] }, { вид: "вернуть", значение: { вид: "переменная", имя: "s" } } ]
  пусть константы = []
  пусть код = []
  пусть локальные = {}
  пусть счётчик = { значение: 0 }
  код_блока(инструкции, константы, код, локальные, счётчик)
  пусть процедуры = [ { name: "главная", codeOffset: 0, argc: 0, localsCount: счётчик.значение } ]
  пусть байткод = { version: 1, moduleName: "Кодоген", constants: константы, procedures: процедуры, code: код }
  система.лог.вывести(система.json.создать(байткод))
  вернуть 0
конец

конец

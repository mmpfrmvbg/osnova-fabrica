модуль Лексер

// Этап 2 self-hosting: лексер подмножества Основы, написанный на самой Основе.
// Разбивает исходник на токены: число, идентификатор/ключевое слово, оператор, скобки.
// Формат токена: "вид|текст" (совпадает с оракулом TS-лексером).

процедура является_буквой(с)
  если с == ""
    вернуть ложь
  конец
  если (с >= "a") и (с <= "z")
    вернуть истина
  конец
  если (с >= "A") и (с <= "Z")
    вернуть истина
  конец
  если (с >= "а") и (с <= "я")
    вернуть истина
  конец
  если (с >= "А") и (с <= "Я")
    вернуть истина
  конец
  если с == "ё"
    вернуть истина
  конец
  если с == "Ё"
    вернуть истина
  конец
  вернуть ложь
конец

процедура является_цифрой(с)
  если с == ""
    вернуть ложь
  конец
  если (с >= "0") и (с <= "9")
    вернуть истина
  конец
  вернуть ложь
конец

процедура вид_имени(имя)
  если имя == "пусть"
    вернуть "пусть"
  конец
  если имя == "если"
    вернуть "если"
  конец
  если имя == "иначе"
    вернуть "иначе"
  конец
  если имя == "пока"
    вернуть "пока"
  конец
  если имя == "вернуть"
    вернуть "вернуть"
  конец
  если имя == "конец"
    вернуть "конец"
  конец
  если имя == "модуль"
    вернуть "модуль"
  конец
  если имя == "процедура"
    вернуть "процедура"
  конец
  если имя == "истина"
    вернуть "истина"
  конец
  если имя == "ложь"
    вернуть "ложь"
  конец
  вернуть "идентификатор"
конец

процедура лексер(источник)
  пусть токены = []
  пусть i = 0
  пусть длина = система.строка.длина(источник)
  пока i < длина
    пусть с = система.строка.подстрока(источник, i, i + 1)
    если с == " "
      i = i + 1
      продолжить
    конец
    если является_цифрой(с)
      пусть число = ""
      пока (i < длина) и является_цифрой(система.строка.подстрока(источник, i, i + 1))
        число = число + система.строка.подстрока(источник, i, i + 1)
        i = i + 1
      конец
      система.массив.добавить(токены, "число|" + число)
      продолжить
    конец
    если является_буквой(с) или с == "_"
      пусть имя = ""
      пока (i < длина) и (является_буквой(система.строка.подстрока(источник, i, i + 1)) или является_цифрой(система.строка.подстрока(источник, i, i + 1)) или система.строка.подстрока(источник, i, i + 1) == "_")
        имя = имя + система.строка.подстрока(источник, i, i + 1)
        i = i + 1
      конец
      система.массив.добавить(токены, вид_имени(имя) + "|" + имя)
      продолжить
    конец
    если с == "="
      если система.строка.подстрока(источник, i + 1, i + 2) == "="
        система.массив.добавить(токены, "==|==")
        i = i + 2
      иначе
        система.массив.добавить(токены, "=|=")
        i = i + 1
      конец
      продолжить
    конец
    если с == "<"
      если система.строка.подстрока(источник, i + 1, i + 2) == "="
        система.массив.добавить(токены, "<=|<=")
        i = i + 2
      иначе
        система.массив.добавить(токены, "<|<")
        i = i + 1
      конец
      продолжить
    конец
    если с == ">"
      если система.строка.подстрока(источник, i + 1, i + 2) == "="
        система.массив.добавить(токены, ">=|>=")
        i = i + 2
      иначе
        система.массив.добавить(токены, ">|>")
        i = i + 1
      конец
      продолжить
    конец
    если с == "+"
      система.массив.добавить(токены, "+|+")
      i = i + 1
      продолжить
    конец
    если с == "-"
      система.массив.добавить(токены, "-|-")
      i = i + 1
      продолжить
    конец
    если с == "*"
      система.массив.добавить(токены, "*|*")
      i = i + 1
      продолжить
    конец
    если с == "/"
      система.массив.добавить(токены, "/|/")
      i = i + 1
      продолжить
    конец
    если с == "("
      система.массив.добавить(токены, "(|(")
      i = i + 1
      продолжить
    конец
    если с == ")"
      система.массив.добавить(токены, ")|)")
      i = i + 1
      продолжить
    конец
    если с == "["
      система.массив.добавить(токены, "[|[")
      i = i + 1
      продолжить
    конец
    если с == "]"
      система.массив.добавить(токены, "]|]")
      i = i + 1
      продолжить
    конец
    если с == "{"
      система.массив.добавить(токены, "{|{")
      i = i + 1
      продолжить
    конец
    если с == "}"
      система.массив.добавить(токены, "}|}")
      i = i + 1
      продолжить
    конец
    если с == ":"
      система.массив.добавить(токены, ":|:")
      i = i + 1
      продолжить
    конец
    если с == ","
      система.массив.добавить(токены, ",|,")
      i = i + 1
      продолжить
    конец
    i = i + 1
  конец
  система.массив.добавить(токены, "конец_файла|")
  вернуть токены
конец

процедура главная()
  пусть т = лексер("пусть x = 12 + 3")
  пусть k = 0
  пока k < система.массив.длина(т)
    система.лог.вывести(т[k])
    k = k + 1
  конец
  вернуть 0
конец

конец

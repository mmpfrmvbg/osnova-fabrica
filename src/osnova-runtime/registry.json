{
  "entries": [
    {
      "kind": "app",
      "id": "notepad.osn",
      "name": "Блокнот ОСи",
      "version": "0.1.0",
      "category": "utility",
      "uiKind": "window",
      "manifestPath": "fixtures\\notepad.osapp.yaml",
      "packagePath": "fixtures",
      "permissions": {
        "files": {
          "read": [
            "~/Документы"
          ],
          "write": [
            "~/Документы/ОСь"
          ]
        },
        "network": {
          "outbound": false
        },
        "system": {
          "clipboard": true
        }
      }
    },
    {
      "kind": "service",
      "id": "osnova.notifications",
      "name": "Уведомления ОСи",
      "version": "0.1.0",
      "category": "system",
      "uiKind": "service",
      "manifestPath": "fixtures\\notifications.osapp.yaml",
      "packagePath": "fixtures",
      "permissions": {
        "system": {
          "notifications": true
        }
      },
      "exports": {
        "invokes": [
          "система.уведомления.показать"
        ],
        "ipcChannels": [
          "osnova.notifications.events"
        ]
      }
    },
    {
      "kind": "app",
      "id": "osnova.todo",
      "name": "TODO ОСи",
      "version": "0.1.0",
      "category": "utility",
      "uiKind": "window",
      "manifestPath": "fixtures\\todo.osapp.yaml",
      "packagePath": "fixtures",
      "permissions": {
        "files": {
          "read": [],
          "write": []
        },
        "network": {
          "outbound": false
        }
      }
    },
    {
      "kind": "app",
      "id": "osnova.viewer",
      "name": "File Viewer ОСи",
      "version": "0.1.0",
      "category": "utility",
      "uiKind": "window",
      "manifestPath": "fixtures\\file-viewer.osapp.yaml",
      "packagePath": "fixtures",
      "permissions": {
        "files": {
          "read": [
            "~/Документы"
          ],
          "write": []
        },
        "network": {
          "outbound": false
        }
      }
    }
  ]
}
// Циклическая мультипроцедурная программа №3: массив в цикле.
//
// Третья форма ILP: обращение к элементам массива внутри цикла. Адресация
// элемента и обработка значения независимы по данным, поэтому у планировщика
// здесь больше свободы, чем в чистой арифметической цепочке.
//
// ФАКТИЧЕСКИЙ результат (проверен прогоном, не выведен на бумаге):
//   сумма_массива([1,2,3,4,5]) = 15
//   максимум([1,2,3,4,5])      = 5
//   статистика([1,2,3,4,5])    = 15 + 2 = 17   (сумма + число чётных)
//   главная()                  = 15 + 5 + 17 = 37
//
// Измеренный выигрыш перестановки: 0.5% (196 -> 195 тактов по модулю).
модуль МассивВЦикле

процедура сумма_массива(числа)
  пусть сумма = 0
  пусть i = 0
  пусть длина = система.массив.длина(числа)
  пока i < длина
    сумма = сумма + система.массив.получить(числа, i)
    i = i + 1
  конец
  вернуть сумма
конец

процедура максимум(числа)
  пусть макс = 0
  пусть i = 0
  пусть длина = система.массив.длина(числа)
  пока i < длина
    пусть значение = система.массив.получить(числа, i)
    если значение > макс
      макс = значение
    конец
    i = i + 1
  конец
  вернуть макс
конец

// Две независимые цепочки по одному массиву: сумма и число чётных.
процедура статистика(числа)
  пусть сумма = 0
  пусть чётных = 0
  пусть i = 0
  пусть длина = система.массив.длина(числа)
  пока i < длина
    пусть значение = система.массив.получить(числа, i)
    сумма = сумма + значение
    если значение % 2 == 0
      чётных = чётных + 1
    конец
    i = i + 1
  конец
  вернуть сумма + чётных
конец

процедура главная()
  пусть числа = [1, 2, 3, 4, 5]
  пусть с = сумма_массива(числа)
  пусть м = максимум(числа)
  пусть ст = статистика(числа)
  вернуть с + м + ст
конец

конец

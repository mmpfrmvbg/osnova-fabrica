модуль статистика

экспорт процедура подсчитать(задачи)
  пусть всего = система.массив.длина(задачи)
  пусть выполнено = 0
  пусть в_работе = 0
  для_каждого задача в задачи
    пусть статус = система.объект.получить(задача, "статус")
    если статус == "готово"
      выполнено = выполнено + 1
    иначе_если статус == "в_работе"
      в_работе = в_работе + 1
    конец
  конец
  вернуть { всего: всего, выполнено: выполнено, в_работе: в_работе }
конец

конец

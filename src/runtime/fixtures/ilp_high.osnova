// Реальный корпус ILP, программа 3: ВЫСОКИЙ ILP.
//
// Много независимых цепочек в цикле: обработка нескольких «каналов» данных
// одновременно. Форма, характерная для обработки сигналов и матричных операций:
// каждый канал накапливается независимо от остальных.
//
// Ожидание: выигрыш в районе 11-14% (по калибровочной кривой для 4-6 цепочек).
модуль ИЛПВысокий

// Шесть независимых аккумуляторов — по одному на «канал».
процедура шесть_каналов(предел)
  пусть к0 = 0
  пусть к1 = 0
  пусть к2 = 0
  пусть к3 = 0
  пусть к4 = 0
  пусть к5 = 0
  пусть i = 1
  пока i <= предел
    к0 = к0 + i * 2
    к1 = к1 + i * 3
    к2 = к2 + i * 5
    к3 = к3 + i * 7
    к4 = к4 + i * 11
    к5 = к5 + i * 13
    i = i + 1
  конец
  вернуть к0 + к1 + к2 + к3 + к4 + к5
конец

// Четыре независимые цепочки с разными операциями: сложение, умножение,
// вычитание, накопление произведения. Разные классы задержек — планировщику
// есть что перекрывать.
процедура четыре_операции(предел)
  пусть с = 0
  пусть п = 1
  пусть р = 0
  пусть пр = 0
  пусть i = 1
  пока i <= предел
    с = с + i
    п = п * (i % 3 + 1)
    р = р - i
    пр = пр + i * 2
    i = i + 1
  конец
  вернуть с + п + р + пр
конец

процедура главная()
  вернуть шесть_каналов(60) + четыре_операции(40)
конец

конец

// Реальный корпус ILP, программа 2: СРЕДНИЙ ILP.
//
// Две-три независимые цепочки в цикле: обработка пары значений параллельно,
// два независимых счётчика. Это типичная форма «реальной» программы, где есть
// небольшая естественная параллельность.
//
// Ожидание: выигрыш в диапазоне 5-9% (по калибровочной кривой для 2-3 цепочек).
модуль ИЛПСредний

// Две независимые цепочки: сумма и число шагов разной чётности.
процедура пара_счётчиков(предел)
  пусть чётная_сумма = 0
  пусть нечётная_сумма = 0
  пусть i = 0
  пока i < предел
    если i % 2 == 0
      чётная_сумма = чётная_сумма + i
    иначе
      нечётная_сумма = нечётная_сумма + i
    конец
    i = i + 1
  конец
  вернуть чётная_сумма + нечётная_сумма
конец

// Три независимые цепочки: минимум, максимум и сумма считаются раздельно.
процедура три_агрегата(предел)
  пусть сумма = 0
  пусть минимум = 1000
  пусть максимум = 0
  пусть i = 1
  пока i <= предел
    пусть значение = i * 7 % 13
    сумма = сумма + значение
    если значение < минимум
      минимум = значение
    конец
    если значение > максимум
      максимум = значение
    конец
    i = i + 1
  конец
  вернуть сумма + минимум + максимум
конец

процедура главная()
  вернуть пара_счётчиков(40) + три_агрегата(30)
конец

конец

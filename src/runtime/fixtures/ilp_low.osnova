// Реальный корпус ILP, программа 1: НИЗКИЙ ILP.
//
// Одна зависимая цепочка в каждой процедуре: результат шага зависит от
// предыдущего. Классический «последовательный» код — бизнес-логика, обход,
// накопление одного значения.
//
// Ожидание: выигрыш перестановки около нуля, потому что критический путь задан
// цепочкой, а не темпом выдачи.
//
// ФАКТИЧЕСКИЙ результат: см. docs/vliw-ilp-calibration.md (значения получены
// прогоном, а не выведены на бумаге).
модуль ИЛПНизкий

// Одна цепочка: каждое следующее значение зависит от предыдущего.
процедура последовательная_сумма(предел)
  пусть акк = 0
  пусть i = 1
  пока i <= предел
    акк = акк + i
    i = i + 1
  конец
  вернуть акк
конец

// Цепочка через вызов: каждое значение зависит от предыдущего вдвойне.
процедура цепочка_через_вызов(предел)
  пусть значение = 1
  пусть i = 0
  пока i < предел
    значение = значение * 2 + 1
    i = i + 1
  конец
  вернуть значение
конец

процедура главная()
  вернуть последовательная_сумма(50) + цепочка_через_вызов(10)
конец

конец

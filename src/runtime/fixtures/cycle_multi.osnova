// Циклическая мультипроцедурная программа №1: две независимые цепочки
// в вызываемой процедуре.
//
// Назначение корпуса: дать замер, который описывает ПРОГРАММУ, а не отдельную
// процедуру. Здесь вызываемая процедура содержит цикл с двумя независимыми
// накоплениями — `сумма` и `удвоения` не зависят друг от друга, поэтому
// планировщику есть что переставлять.
//
// ФАКТИЧЕСКИЙ результат (проверен прогоном, не выведен на бумаге):
//   сумма_до(10)     = 55
//   работа(8)        = 36 + 256 = 292
//   разность(10, 5)  = 40
//   главная()        = 292 + 40 = 332
//
// Измеренный выигрыш перестановки — см. `docs/vliw-e2k-model.md`, §4.
// Закономерность корпуса: выигрыш растёт с числом НЕЗАВИСИМЫХ цепочек в цикле
// (1 цепочка — 0%, 2 — около 5.6%, 3 — 9%, 4 — 11.3%, 6 — 14%).
модуль ЦиклоМульти

процедура сумма_до(предел)
  пусть сумма = 0
  пусть i = 1
  пока i <= предел
    сумма = сумма + i
    i = i + 1
  конец
  вернуть сумма
конец

// Ключевая процедура корпуса: ДВЕ независимые цепочки в одном цикле.
// `сумма` и `удвоения` не связаны по данным — это и есть ILP.
процедура работа(предел)
  пусть сумма = 0
  пусть удвоения = 1
  пусть i = 1
  пока i <= предел
    сумма = сумма + i
    удвоения = удвоения * 2
    i = i + 1
  конец
  вернуть сумма + удвоения
конец

процедура разность_сумм(а, б)
  пусть п = сумма_до(а)
  пусть м = сумма_до(б)
  вернуть п - м
конец

процедура главная()
  пусть р = работа(8)
  пусть д = разность_сумм(10, 5)
  вернуть р + д
конец

конец

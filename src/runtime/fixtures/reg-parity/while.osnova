// Шаг 1.1 регистрового ядра: `пока` + `прервать` + `продолжить`.
// Эталон: стековая VM. Сумма 0..4 = 10, затем цикл с прерыванием и пропуском.

процедура сумма_до(предел)
  пусть i = 0
  пусть сумма = 0
  пока i < предел
    сумма = сумма + i
    i = i + 1
  конец
  вернуть сумма
конец

процедура первый_больше(порог)
  пусть n = 0
  пока истина
    n = n + 1
    если n > порог
      прервать
    конец
  конец
  вернуть n
конец

процедура сумма_нечётных_до(предел)
  пусть i = 0
  пусть сумма = 0
  пока i < предел
    i = i + 1
    если i % 2 == 0
      продолжить
    конец
    сумма = сумма + i
  конец
  вернуть сумма
конец

процедура главная()
  пусть a = сумма_до(5)
  пусть b = первый_больше(3)
  пусть c = сумма_нечётных_до(6)
  вернуть a * 100 + b * 10 + c
конец

конец

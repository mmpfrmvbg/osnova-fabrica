// Шаг 1.4 регистрового ядра: `попробовать` / `иначе_попытка` / `выбросить`,
// вложенные блоки, выброс через вызов процедуры, значение-объект в исключении
// и `поймать` как алиас. Эталон: стековая VM.

процедура проверить(значение)
  если значение < 0
    выбросить "отрицательное"
  конец
  вернуть значение * 2
конец

процедура безопасно(значение)
  попробовать
    вернуть проверить(значение)
  поймать ошибка
    вернуть -1
  конец
конец

процедура вложенно(значение)
  попробовать
    попробовать
      если значение == 1
        выбросить "внутреннее"
      конец
      вернуть 100
    иначе_попытка вн
      выбросить "внешнее"
    конец
  поймать внеш
    вернуть 200
  конец
конец

процедура восстановление(значение)
  пусть итог = 0
  попробовать
    итог = проверить(значение)
  поймать ошибка
    итог = 7
  конец
  вернуть итог + 1
конец

процедура главная()
  пусть a = безопасно(5)
  пусть b = безопасно(-5)
  пусть c = вложенно(1)
  пусть d = восстановление(-1)
  вернуть a * 1000 + b * 100 + c * 10 + d
конец

конец

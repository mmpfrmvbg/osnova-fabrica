модуль RegКортежи

// Шаг 1.3 регистрового ядра: кортежи (`вернуть a, b`), распаковка
// (`пусть x, y = вызов()`) и кортеж как значение. Эталон: стековая VM,
// где кортеж — массив.

процедура пару()
  вернуть 3, 4
конец

процедура сумма_и_разность(а, б)
  вернуть а + б, а - б
конец

процедура разложить()
  пусть с, р = сумма_и_разность(10, 4)
  вернуть с * 100 + р
конец

процедура поэлементно()
  пусть x, y = пару()
  пусть z = x * y
  вернуть z
конец

процедура три()
  вернуть 1, 2, 3
конец

процедура из_трёх()
  пусть a, b, c = три()
  вернуть a * 100 + b * 10 + c
конец

процедура главная()
  пусть первый = разложить()
  пусть второй = поэлементно()
  пусть третий = из_трёх()
  вернуть первый + второй + третий
конец

конец

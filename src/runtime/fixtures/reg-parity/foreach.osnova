// Шаг 1.2 регистрового ядра: `для_каждого` (элемент, индекс, `прервать`,
// вложенный проход). Эталон: стековая VM, контракт `система.итератор.из` +
// `система.массив.получить` + `система.массив.длина`.

процедура сумма(числа)
  пусть итог = 0
  для_каждого ч в числа
    итог = итог + ч
  конец
  вернуть итог
конец

процедура взвешенная(числа)
  пусть итог = 0
  для_каждого ч, i в числа
    итог = итог + ч * (i + 1)
  конец
  вернуть итог
конец

процедура до_порога(числа, порог)
  пусть итог = 0
  для_каждого ч в числа
    если ч > порог
      прервать
    конец
    итог = итог + ч
  конец
  вернуть итог
конец

процедура суммы_внутренних(строки)
  пусть итог = 0
  для_каждого строка в строки
    для_каждого ч в строка
      итог = итог + ч
    конец
  конец
  вернуть итог
конец

процедура главная()
  пусть числа = [1, 2, 3, 4]
  пусть вложенные = [[1, 2], [3, 4], [5]]
  пусть a = сумма(числа)
  пусть b = взвешенная(числа)
  пусть c = до_порога(числа, 3)
  пусть d = суммы_внутренних(вложенные)
  вернуть a * 1000 + b * 100 + c * 10 + d
конец

конец

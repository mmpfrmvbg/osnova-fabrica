// Циклическая мультипроцедурная программа №2: вложенные циклы.
//
// Вложенность проверяется отдельно: планировщик обязан корректно обрабатывать
// внутренний цикл внутри внешнего, а перестановка не должна ломать ни границы
// внутреннего цикла, ни нумерацию служебных ячеек (инварианты `для_каждого`
// добыты дорого — см. memory/sessions/2026-09-14-vm-parity.md).
//
// ФАКТИЧЕСКИЙ результат (проверен прогоном):
//   сумма_квадратов(5) = 1+4+9+16+25 = 55
//   таблица_сумм(3)    = (1+2+3)+(2+4+6)+(3+6+9) = 6+12+18 = 36
//   главная()          = 55 + 36 = 91

процедура сумма_квадратов(предел)
  пусть сумма = 0
  пусть i = 1
  пока i <= предел
    сумма = сумма + i * i
    i = i + 1
  конец
  вернуть сумма
конец

// Внешний цикл по строкам, внутренний — по столбцам.
процедура таблица_сумм(строк)
  пусть итог = 0
  пусть строка = 1
  пока строка <= строк
    пусть строка_сумма = 0
    пусть столбец = 1
    пока столбец <= строк
      строка_сумма = строка_сумма + строка * столбец
      столбец = столбец + 1
    конец
    итог = итог + строка_сумма
    строка = строка + 1
  конец
  вернуть итог
конец

процедура главная()
  вернуть сумма_квадратов(5) + таблица_сумм(3)
конец

конец

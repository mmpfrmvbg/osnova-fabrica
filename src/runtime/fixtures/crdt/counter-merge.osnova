// CRDT-вариант 1: G-Counter — слияние по НЕЗАВИСИМЫМ репликам.
//
// Проверяется утверждение из docs/osnova-signature-spec.md: коммутативность
// слияния — это «порядок независимых частей не важен», то есть предусловие
// перестановки. Здесь части (реплики) действительно независимы: слияние по
// каждой реплике — максимум, и результаты по репликам друг от друга не зависят.
//
// ФАКТИЧЕСКИЙ результат (проверен прогоном, не выведен на бумаге):
//   слияние_счётчиков([1,2,3],[3,1,2]) = [3,2,3], сумма = 8
//   главная() = 8
модуль СлияниеСчётчиков

процедура слияние_реплики(а, б)
  пусть i = 0
  пусть длина = система.массив.длина(а)
  пусть итог = []
  пока i < длина
    пусть левое = система.массив.получить(а, i)
    пусть правое = система.массив.получить(б, i)
    пусть большее = левое
    если правое > левое
      большее = правое
    конец
    система.массив.добавить(итог, большее)
    i = i + 1
  конец
  вернуть итог
конец

процедура сумма_реплик(значения)
  пусть сумма = 0
  пусть i = 0
  пусть длина = система.массив.длина(значения)
  пока i < длина
    сумма = сумма + система.массив.получить(значения, i)
    i = i + 1
  конец
  вернуть сумма
конец

процедура главная()
  пусть а = [1, 2, 3]
  пусть б = [3, 1, 2]
  пусть слитое = слияние_реплики(а, б)
  вернуть сумма_реплик(слитое)
конец

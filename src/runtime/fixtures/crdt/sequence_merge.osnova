// CRDT-вариант 3: последовательный merge — порядок ЗАВИСИМ, перестановка не поможет.
//
// Форма, которой атом B4 тоже соответствует: элемент вставляется относительно
// предыдущего (как в sequence-CRDT: позиция зависит от позиции соседа). Здесь
// цепочка зависимая по построению, поэтому максимум, что может планировщик, —
// упаковать независимые от цепочки операции вокруг неё.
//
// Фикстура — вторая негативная половина проверки B4: коммутативность по элементам
// набора НЕ равна независимости операций внутри одного элемента.
//
// ФАКТИЧЕСКИЙ результат (проверен прогоном): главная() = 11
// Измеренная плотность упаковки: 1.00 → 1.50 → 1.56 — то есть вокруг зависимой
// цепочки всё равно есть что упаковать. Это и есть отрицательный результат
// проверки: по плотности ВСЕЙ программы нельзя судить об оптимизируемости атома.

процедура накопить(числа)
  пусть накопленное = 0
  пусть i = 0
  пусть длина = система.массив.длина(числа)
  пока i < длина
    пусть значение = система.массив.получить(числа, i)
    накопленное = накопленное * 2 + значение
    i = i + 1
  конец
  вернуть накопленное
конец

процедура главная()
  пусть числа = [1, 2, 3]
  вернуть накопить(числа)
конец

процедура запуск()
  пусть окно = система.окно.создать_окно("TODO", 400, 300)
  система.окно.показать(окно)
  система.интерфейс.поле_ввода("1", "Новая задача", "input1")
  система.интерфейс.кнопка("1", "Добавить", "add_btn")
  система.интерфейс.текст("1", "Items:", "items_label")
  система.интерфейс.область_текста("1", "", "items_area")
  система.интерфейс.установить_значение("items_area", система.хранилище.прочитать("items"))
  цикл
    пусть события = система.окно.получить_события()
    пусть idx = 0
    пока idx < система.массив.длина(события)
      если handle_event(система.массив.получить(события, idx)) == 1
        вернуть
      конец
      idx = idx + 1
    конец
    система.время.спать(200)
  конец
конец

процедура handle_event(событие)
  если система.объект.получить(событие, "тип") == "закрытие"
    система.окно.закрыть(1)
    вернуть 1
  конец
  если система.объект.получить(событие, "виджет_id") == "add_btn"
    handle_add()
    вернуть 0
  конец
  вернуть 0
конец

процедура handle_add()
  пусть текст = система.интерфейс.получить_значение("input1")
  пусть новые = система.строка.объединить(система.строка.объединить(система.хранилище.прочитать("items"), "\n"), текст)
  система.хранилище.записать("items", новые)
  система.интерфейс.установить_значение("items_area", новые)
  система.интерфейс.установить_значение("input1", "")
конец

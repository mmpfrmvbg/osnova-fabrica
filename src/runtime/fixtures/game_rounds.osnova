модуль game_rounds

процедура запуск()
  пусть окно = система.окно.создать_окно("Раунды", 320, 240)
  система.окно.показать(окно)
  система.интерфейс.текст("1", "Игровая логика (golden: run_golden)", "label1")
  цикл
    пусть события = система.окно.получить_события()
    для_каждого э в события
      если handle_event(э) == 1
        вернуть
      конец
    конец
    система.время.спать(200)
  конец
конец

процедура handle_event(событие)
  если система.объект.получить(событие, "тип") == "закрытие"
    система.окно.закрыть(1)
    вернуть 1
  конец
  вернуть 0
конец

процедура сумма_очков(раунды)
  пусть всего = 0
  для_каждого р в раунды
    пусть о = система.объект.получить(р, "очки")
    всего = всего + о
  конец
  система.хранилище.записать("total_points", система.строка.объединить(всего, ""))
конец

процедура количество_побед(раунды)
  пусть счёт = 0
  для_каждого р в раунды
    если система.объект.получить(р, "результат") == "победа"
      счёт = счёт + 1
    конец
  конец
  система.хранилище.записать("wins", система.строка.объединить(счёт, ""))
конец

процедура бонусные_победы(раунды)
  пусть счёт = 0
  для_каждого р в раунды
    пусть рез = система.объект.получить(р, "результат")
    пусть о = система.объект.получить(р, "очки")
    если рез == "победа" и о >= 10
      счёт = счёт + 1
    конец
  конец
  система.хранилище.записать("bonus_wins", система.строка.объединить(счёт, ""))
конец

процедура run_golden(раунды)
  сумма_очков(раунды)
  количество_побед(раунды)
  бонусные_победы(раунды)
конец

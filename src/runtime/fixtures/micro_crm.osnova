процедура запуск()
  пусть окно = система.окно.создать_окно("Клиенты", 400, 300)
  система.окно.показать(окно)
  система.интерфейс.текст("1", "Micro-CRM (golden: run_golden с массивом)", "label1")
  цикл
    пусть события = система.окно.получить_события()
    для_каждого э в события
      если handle_event(э) == 1
        вернуть
      конец
    конец
    система.время.спать(200)
  конец
конец

процедура handle_event(событие)
  если система.объект.получить(событие, "тип") == "закрытие"
    система.окно.закрыть(1)
    вернуть 1
  конец
  вернуть 0
конец

процедура подсчитать_баланс(клиенты)
  пусть сумма = 0
  для_каждого к в клиенты
    пусть б = система.объект.получить(к, "баланс")
    сумма = сумма + б
  конец
  система.хранилище.записать("total_balance", система.строка.объединить(сумма, ""))
конец

процедура количество_активных(клиенты)
  пусть счёт = 0
  для_каждого к в клиенты
    если система.объект.получить(к, "статус") == "активен"
      счёт = счёт + 1
    конец
  конец
  система.хранилище.записать("active_count", система.строка.объединить(счёт, ""))
конец

процедура баланс_активных(клиенты)
  пусть сумма = 0
  для_каждого к в клиенты
    пусть ст = система.объект.получить(к, "статус")
    пусть б = система.объект.получить(к, "баланс")
    если ст == "активен" и б > 0
      сумма = сумма + б
    конец
  конец
  система.хранилище.записать("balance_active", система.строка.объединить(сумма, ""))
конец

процедура количество_активных_или_новых(клиенты)
  пусть счёт = 0
  для_каждого к в клиенты
    пусть ст = система.объект.получить(к, "статус")
    если ст == "активен" или ст == "новый"
      счёт = счёт + 1
    конец
  конец
  система.хранилище.записать("active_or_new_count", система.строка.объединить(счёт, ""))
конец

процедура run_golden(клиенты)
  подсчитать_баланс(клиенты)
  количество_активных(клиенты)
  баланс_активных(клиенты)
  количество_активных_или_новых(клиенты)
конец

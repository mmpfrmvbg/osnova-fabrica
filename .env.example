# LLM провайдер: qwen-cli | deepseek | ollama
OSNOVA_PROVIDER=qwen-cli

# Обязателен при OSNOVA_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...

# Опциональные
OSNOVA_MODEL=qwen-coder-plus
# OLLAMA_URL=http://localhost:11434
# OSNOVA_TRACE_DB=./runs/traces.jsonl
# LOG_LEVEL=info
# QWEN_TIMEOUT_MS=300000

# --- Посфазная маршрутизация LLM (см. docs/llm-routing-v1.md) ---
# Тир: auto (Flash + эскалация repair→Pro) | flash | pro
# OSNOVA_TIER=auto
# Уровень усилий: low (без thinking) | med (баланс) | high (максимум)
# OSNOVA_LEVEL=med
# Точечные override модели по фазам (приоритетнее тира):
# OSNOVA_MODEL_INTAKE=deepseek-flash
# OSNOVA_MODEL_SPEC=deepseek-flash
# OSNOVA_MODEL_CODEGEN=deepseek-flash
# OSNOVA_MODEL_REPAIR=deepseek-pro

# Forge: Cursor Agent в smith.sh (headless). Подхватывается из этого файла или forge/.env
# (см. forge/common.py — слияние forge/.env + <OSNOVA_PROJECT>/.env).
# CURSOR_API_KEY=

# --- OSNOVA CLI (osnova status, health, log, run, …) ---
# Полный шаблон: см. .env.cli.example в корне репозитория.
# OSNOVA_PROJECT=.
# OSNOVA_FORGE=/opt/osnova-forge
# OSNOVA_STATE_DIR=
# QWEN_BIN=qwen
# CURSOR_BIN=cursor-agent
# GH_TOKEN=
# GH_REPO=

# Shell completion (Typer): osnova --install-completion bash
# или: osnova --show-completion bash

модуль ТудуСервис

тип Задача
  поле ид текст
  поле заголовок текст
  поле проект текст
  поле статус текст
  поле приоритет число
конец

процедура создать_задачу(заголовок текст, проект текст) текст
  пусть ид = система.утилиты.уид()
  пусть задача = Задача{
    ид: ид,
    заголовок: заголовок,
    проект: проект,
    статус: "inbox",
    приоритет: 3
  }
  система.хранилище.установить("задача:" + ид, задача)
  вернуть ид
конец

процедура получить_задачи(проект текст) список
  пусть ключи = система.хранилище.ключи("задача:")
  пусть результат = список[]
  пока ключи.длина > 0
    пусть ключ = ключи.взять()
    пусть задача = система.хранилище.получить(ключ)
    если задача.проект == проект
      результат.добавить(задача)
    конец
  конец
  вернуть результат
конец

процедура главная()
  система.лог.вывести("ТудуСервис запущен")
конец

конец

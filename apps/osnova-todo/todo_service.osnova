процедура создать_задачу(заголовок, проект)
  пусть ид = система.время.сейчас()
  пусть ключ = система.строка.объединить("задача:", ид)
  пусть значение = система.строка.объединить(заголовок, "|")
  значение = система.строка.объединить(значение, проект)
  значение = система.строка.объединить(значение, "|inbox|3")
  система.хранилище.записать(ключ, значение)
  система.лог.вывести(система.строка.объединить("Создана задача: ", ключ))
  вернуть ключ
конец

процедура получить_задачу(ключ)
  пусть значение = система.хранилище.прочитать(ключ)
  система.лог.вывести(система.строка.объединить("Задача: ", значение))
  вернуть значение
конец

процедура список_задач_проекта(проект)
  пусть все_ключи = система.хранилище.ключи()
  пусть результат = система.массив.создать()
  пусть индекс = 0
  пусть длина = система.массив.длина(все_ключи)
  пока индекс < длина
    пусть ключ = система.массив.получить(все_ключи, индекс)
    если система.строка.начинается_с(ключ, "задача:")
      пусть значение = система.хранилище.прочитать(ключ)
      если система.строка.содержит(значение, проект)
        результат = система.массив.добавить(результат, ключ)
      конец
    конец
    индекс = индекс + 1
  конец
  вернуть результат
конец

процедура главная()
  система.лог.вывести("ТудуСервис v1 запущен")
  пусть ключ = создать_задачу("Тест фабрики", "osnova")
  получить_задачу(ключ)
  пусть задачи = список_задач_проекта("osnova")
  пусть кол = система.массив.длина(задачи)
  система.лог.вывести(система.строка.объединить("Задач в проекте: ", кол))
конец

конец

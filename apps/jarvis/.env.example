# apps/jarvis/.env.example
# Скопируйте в .env и заполните значения
#
# Также можно положить BOT_TOKEN в .env в КОРНЕ монорепо — index.ts подхватит его.

# ── Транспорт ─────────────────────────────────────────────────────────────────
# Режим запуска: http (по умолчанию) или telegram
# npm run jarvis:http      → TRANSPORT=http
# npm run jarvis:telegram  → TRANSPORT=telegram
# npm run jarvis:tunnel    → TRANSPORT=http + USE_TUNNEL=true
TRANSPORT=http

# ── HTTP-сервер ───────────────────────────────────────────────────────────────
# Порт Express-сервера (по умолчанию 3000)
HTTP_PORT=3000

# Включить Cloudflare Tunnel при старте (требует установленного cloudflared)
# true = пробросить публичный HTTPS-адрес через trycloudflare.com
USE_TUNNEL=false

# ── Cloudflare Tunnel — установка ─────────────────────────────────────────────
# https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/
# Linux/macOS: curl -L https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 -o cloudflared && chmod +x cloudflared && sudo mv cloudflared /usr/local/bin/

# ── Telegram-бот (опционально) ────────────────────────────────────────────────
# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=

# Ваш Telegram user_id (узнать через @userinfobot)
JARVIS_OWNER_ID=

# ── База данных ───────────────────────────────────────────────────────────────
# Путь к SQLite файлу (по умолчанию apps/jarvis/jarvis.db)
JARVIS_DB_PATH=./jarvis.db

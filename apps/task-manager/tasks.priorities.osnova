модуль ЗадачиПриоритеты

процедура экспорт высокий()
  вернуть "высокий"
конец

процедура экспорт средний()
  вернуть "средний"
конец

процедура экспорт низкий()
  вернуть "низкий"
конец

процедура экспорт сравнить(приоритет_а, приоритет_б)
  пусть вес_а = получить_вес(приоритет_а)
  пусть вес_б = получить_вес(приоритет_б)
  если вес_а > вес_б
    вернуть 1
  иначе_если вес_а < вес_б
    вернуть -1
  иначе
    вернуть 0
  конец
конец

процедура получить_вес(приоритет)
  если приоритет == "высокий"
    вернуть 3
  иначе_если приоритет == "средний"
    вернуть 2
  иначе
    вернуть 1
  конец
конец

процедура экспорт серверный_приоритет(приоритет)
  // Серверная шкала 1..5 для совместимости с model v2.
  если приоритет == "высокий"
    вернуть 5
  иначе_если приоритет == "средний"
    вернуть 3
  иначе
    вернуть 1
  конец
конец

конец

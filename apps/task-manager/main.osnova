модуль ТаскМенеджер

использовать модуль ЗадачиЯдро из "tasks.core.osnova"
использовать модуль ЗадачиПриоритеты из "tasks.priorities.osnova"
использовать модуль ЗадачиФильтры из "tasks.filters.osnova"
использовать модуль ЗадачиХранилище из "tasks.storage.osnova"

процедура главная()
  система.лог.вывести("ТаскМенеджер v1.0 — старт")

  пусть ключ1 = ЗадачиЯдро.создать("Изучить язык Основа", "Пройти все туториалы", "высокий")
  пусть ключ2 = ЗадачиЯдро.создать("Написать таск-менеджер", "Микромодульная архитектура", "высокий")
  пусть ключ3 = ЗадачиЯдро.создать("Написать тесты", "Golden-тесты для всех модулей", "средний")

  система.лог.вывести("Создано задач: 3")

  пусть все = ЗадачиЯдро.список()
  пусть кол = система.массив.длина(все)
  система.лог.вывести(система.строка.объединить("Всего в хранилище: ", кол))

  пусть активные = ЗадачиФильтры.активные(все)
  пусть кол_активных = система.массив.длина(активные)
  система.лог.вывести(система.строка.объединить("Активных задач: ", кол_активных))

  пусть высокий = ЗадачиПриоритеты.высокий()
  пусть важные = ЗадачиФильтры.по_приоритету(все, высокий)
  пусть кол_важных = система.массив.длина(важные)
  система.лог.вывести(система.строка.объединить("Высокий приоритет: ", кол_важных))

  ЗадачиЯдро.удалить(ключ3)
  пусть после_удаления = ЗадачиЯдро.список()
  пусть кол_после = система.массив.длина(после_удаления)
  система.лог.вывести(система.строка.объединить("После удаления: ", кол_после))

  вернуть кол_после
конец

конец

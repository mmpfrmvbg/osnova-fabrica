процедура экспорт создать(заголовок, описание, приоритет, дедлайн)
  пусть ид = система.время.метка()
  пусть ключ = система.строка.объединить("задача:", ид)
  пусть данные = система.строка.объединить(заголовок, "|")
  данные = система.строка.объединить(данные, описание)
  данные = система.строка.объединить(данные, "|todo|")
  данные = система.строка.объединить(данные, приоритет)
  данные = система.строка.объединить(данные, "|")
  данные = система.строка.объединить(данные, дедлайн)
  система.хранилище.записать(ключ, данные)
  вернуть ключ
конец

процедура экспорт получить(ключ)
  вернуть система.хранилище.прочитать(ключ)
конец

процедура экспорт обновить(ключ, новые_данные)
  система.хранилище.записать(ключ, новые_данные)
  вернуть истина
конец

процедура экспорт удалить(ключ)
  система.хранилище.удалить(ключ)
  вернуть истина
конец

процедура экспорт список()
  вернуть система.хранилище.ключи_с_префиксом("задача:")
конец

процедура экспорт спек(ключ, проект)
  // Генерирует JSON-спецификацию для сервера POST /tasks
  пусть данные = система.хранилище.прочитать(ключ)
  если данные == пусто
    вернуть "{}"
  конец

  пусть части = система.строка.разделить(данные, "|")
  пусть заголовок = система.массив.получить(части, 0)
  пусть описание = система.массив.получить(части, 1)
  пусть статус = система.массив.получить(части, 2)
  пусть приоритет_текст = система.массив.получить(части, 3)
  пусть дедлайн = система.массив.получить(части, 4)

  пусть приоритет = ЗадачиПриоритеты.серверный_приоритет(приоритет_текст)

  пусть deadline_part = "\"deadline\":null"
  если дедлайн != пусто
    deadline_part = система.строка.объединить("\"deadline\":\"", дедлайн, "\"")
  конец

  вернуть система.строка.объединить(
    "{",
    "\"title\":\"", заголовок, "\",",
    "\"description\":\"", описание, "\",",
    "\"project\":\"", проект, "\",",
    "\"type\":\"task\",",
    "\"priority\":", приоритет, ",",
    "\"size\":\"m\",",
    "\"status\":\"", статус, "\",",
    deadline_part, ",",
    "\"recurrence_rule\":null,",
    "\"tags\":[],",
    "\"metadata\":{}",
    "}"
  )
конец

конец

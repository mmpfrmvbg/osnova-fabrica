модуль ЗадачиФильтры

процедура экспорт по_статусу(ключи, статус)
  пусть результат = система.массив.создать()
  для_каждого ключ в ключи
    пусть данные = система.хранилище.прочитать(ключ)
    если система.строка.содержит(данные, статус)
      результат = система.массив.добавить(результат, ключ)
    конец
  конец
  вернуть результат
конец

процедура экспорт по_приоритету(ключи, приоритет)
  пусть результат = система.массив.создать()
  для_каждого ключ в ключи
    пусть данные = система.хранилище.прочитать(ключ)
    если система.строка.содержит(данные, приоритет)
      результат = система.массив.добавить(результат, ключ)
    конец
  конец
  вернуть результат
конец

процедура экспорт активные(ключи)
  вернуть по_статусу(ключи, "активна")
конец

процедура экспорт просроченные(ключи)
  пусть результат = система.массив.создать()
  пусть сейчас = система.время.метка()
  для_каждого ключ в ключи
    пусть данные = система.хранилище.прочитать(ключ)
    если данные == пусто
      продолжить
    конец
    пусть части = система.строка.разделить(данные, "|")
    пусть дедлайн = система.массив.получить(части, 4)
    если дедлайн == пусто
      продолжить
    конец
    пусть дни = система.время.разница_дней(дедлайн, сейчас)
    если дни < 0
      результат = система.массив.добавить(результат, ключ)
    конец
  конец
  вернуть результат
конец

конец

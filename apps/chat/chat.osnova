модуль чат

процедура главная(сервер)
  система.лог.вывести("Чат запущен")
  система.лог.вывести(сервер)
  пусть user_id = "android-user"
  пусть message = "привет от Основы"
  пусть тело = система.строка.объединить("{\"userId\":\"", user_id)
  пусть тело = система.строка.объединить(тело, "\",\"message\":\"")
  пусть тело = система.строка.объединить(тело, message)
  пусть тело = система.строка.объединить(тело, "\"}")
  система.лог.вывести("Тело запроса:")
  система.лог.вывести(тело)
  попробовать
    пусть ответ = система.сеть.пост(сервер, тело)
    система.лог.вывести("Ответ Jarvis:")
    система.лог.вывести(ответ)
  иначе_попытка е
    система.лог.вывести("Ошибка соединения:")
    система.лог.вывести(е)
  конец
конец

конец

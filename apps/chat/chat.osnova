модуль чат

процедура главная(сервер)
  система.лог.вывести("Чат запущен")
  система.лог.вывести(сервер)
  пусть user_id = "android-user"
  пусть message = "привет от Основы"
  пусть тело = система.строка.объединить("{\"userId\":\"", user_id)
  тело = система.строка.объединить(тело, "\",\"message\":\"")
  тело = система.строка.объединить(тело, message)
  тело = система.строка.объединить(тело, "\"}")
  попробовать
    пусть ответ_json = система.сеть.пост(сервер, тело)
    пусть ответ = система.json.разобрать(ответ_json)
    пусть текст = система.объект.получить(ответ, "reply")
    система.лог.вывести("Jarvis:")
    система.лог.вывести(текст)
  иначе_попытка е
    система.лог.вывести("Ошибка:")
    система.лог.вывести(е)
  конец
конец

конец

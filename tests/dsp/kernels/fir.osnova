// FIR-фильтр (ядро DSP, целочисленное, детерминированное).
//
// Задача: y[n] = сумма по k от 0 до K-1: h[k] * x[n-k], для n от K-1 до длины x - 1.
// Возврат: сумма всех выходных отсчётов (целое) — удобная свёртка результата в одно
// число, по которому сверяют реализацию.
//
// Вход: x = [3, 1, 4, 1, 5, 9, 2, 6], h = [1, 2, 3, 4].
// Эталон: tests/dsp/reference.py
модуль ЯдроФИР

процедура фильтр(вход, коэффициенты)
  пусть выход = []
  пусть ширина = система.массив.длина(коэффициенты)
  пусть длина = система.массив.длина(вход)
  пусть n = ширина - 1
  пока n < длина
    пусть сумма = 0
    пусть k = 0
    пока k < ширина
      пусть значение = система.массив.получить(вход, n - k)
      пусть вес = система.массив.получить(коэффициенты, k)
      сумма = сумма + значение * вес
      k = k + 1
    конец
    система.массив.добавить(выход, сумма)
    n = n + 1
  конец
  вернуть выход
конец

процедура сумма(значения)
  пусть итог = 0
  пусть i = 0
  пусть длина = система.массив.длина(значения)
  пока i < длина
    итог = итог + система.массив.получить(значения, i)
    i = i + 1
  конец
  вернуть итог
конец

процедура главная()
  пусть вход = [3, 1, 4, 1, 5, 9, 2, 6]
  пусть коэффициенты = [1, 2, 3, 4]
  вернуть сумма(фильтр(вход, коэффициенты))
конец

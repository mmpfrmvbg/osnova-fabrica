// IIR-фильтр первого порядка (ядро DSP, целочисленное).
//
// Задача: y[n] = (3 * x[n] + 2 * y[n-1]) / 5, y[-1] = 0 — целочисленное деление.
//
// ВАЖНО ПРО ЯЗЫК: оператор `/` в Основа — ВЕЩЕСТВЕННОЕ деление (проверено прогоном: наивная
// запись дала 121.0656 вместо 119), а целочисленное — оператор `div` (БЛОК 2: отсечение К НУЛЮ,
// как `SDIVs` на Эльбрусе и `Math.trunc` на VM). Здесь стоит именно `div`.
//
// Прежняя редакция выражала целочисленное деление трюком через остаток: (a - a % b) / b. Это был
// обход отсутствия `div`, и он не годился при отрицательных (нужна была отдельная обработка знака).
// Трюк снят 2026-09-25: он давал единственный оставшийся отказ понижения во всём конвейере
// (`IR.div` — вещественное деление, форма есть, но семантика другая), а `div` понижается в `SDIVs`.
//
// Возврат: сумма всех выходных отсчётов.
// Вход: x = [10, 20, 30, 40, 50].
// Эталон: tests/dsp/reference.py
//
// Замечание: обратная связь по выходу делает цепочку зависимой — это честный случай
// «задача с низким ILP», и он нужен именно как негативная половина корпуса.
модуль ЯдроИИР

процедура целое_деление(числитель, знаменатель)
  вернуть числитель div знаменатель
конец

процедура фильтр(вход)
  пусть выход = []
  пусть предыдущий = 0
  пусть i = 0
  пусть длина = система.массив.длина(вход)
  пока i < длина
    пусть значение = система.массив.получить(вход, i)
    пусть числитель = 3 * значение + 2 * предыдущий
    пусть текущий = целое_деление(числитель, 5)
    система.массив.добавить(выход, текущий)
    предыдущий = текущий
    i = i + 1
  конец
  вернуть выход
конец

процедура сумма(значения)
  пусть итог = 0
  пусть i = 0
  пусть длина = система.массив.длина(значения)
  пока i < длина
    итог = итог + система.массив.получить(значения, i)
    i = i + 1
  конец
  вернуть итог
конец

процедура главная()
  пусть вход = [10, 20, 30, 40, 50]
  вернуть сумма(фильтр(вход))
конец

// Свёртка (ядро DSP, целочисленное).
//
// Задача: полная свёртка (a * b)[n] = сумма по k: a[k] * b[n-k], для n от 0 до
// длины a + длины b - 2.
// Возврат: сумма всех отсчётов свёртки.
//
// Вход: a = [1, 2, 3], b = [4, 5, 6].
// Эталон: tests/dsp/reference.py
модуль ЯдроСвёртка

процедура свёртка(а, б)
  пусть выход = []
  пусть длина_а = система.массив.длина(а)
  пусть длина_б = система.массив.длина(б)
  пусть n = 0
  пока n < длина_а + длина_б - 1
    пусть сумма = 0
    пусть k = 0
    пока k < длина_а
      пусть j = n - k
      если j >= 0
        если j < длина_б
          пусть левое = система.массив.получить(а, k)
          пусть правое = система.массив.получить(б, j)
          сумма = сумма + левое * правое
        конец
      конец
      k = k + 1
    конец
    система.массив.добавить(выход, сумма)
    n = n + 1
  конец
  вернуть выход
конец

процедура сумма(значения)
  пусть итог = 0
  пусть i = 0
  пусть длина = система.массив.длина(значения)
  пока i < длина
    итог = итог + система.массив.получить(значения, i)
    i = i + 1
  конец
  вернуть итог
конец

процедура главная()
  пусть а = [1, 2, 3]
  пусть б = [4, 5, 6]
  вернуть сумма(свёртка(а, б))
конец

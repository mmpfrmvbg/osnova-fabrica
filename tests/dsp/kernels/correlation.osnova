// Взаимная корреляция (ядро DSP, целочисленное).
//
// Задача: r[lag] = сумма по i: a[i] * b[i + lag], для lag от 0 до длины b - длины a.
// Возврат: сумма всех значений корреляции по всем допустимым сдвигам.
//
// Вход: a = [1, 2, 3], b = [4, 5, 6].
// Эталон: tests/dsp/reference.py
//
// Связь со свёрткой: корреляция выражается через свёртку с обращённой последовательностью,
// но здесь считается напрямую — так ядро не зависит от порядка обращения индексов.
// Шапки `модуль ЯдроКорреляция` нет: канон языка — файл = модуль (§13.3 docs/language-v2.md).

процедура корреляция(а, б)
  пусть выход = []
  пусть длина_а = система.массив.длина(а)
  пусть длина_б = система.массив.длина(б)
  пусть общий = длина_б - длина_а
  пусть lag = 0
  пока lag <= общий
    пусть сумма = 0
    пусть i = 0
    пока i < длина_а
      пусть левое = система.массив.получить(а, i)
      пусть правое = система.массив.получить(б, i + lag)
      сумма = сумма + левое * правое
      i = i + 1
    конец
    система.массив.добавить(выход, сумма)
    lag = lag + 1
  конец
  вернуть выход
конец

процедура сумма(значения)
  пусть итог = 0
  пусть i = 0
  пусть длина = система.массив.длина(значения)
  пока i < длина
    итог = итог + система.массив.получить(значения, i)
    i = i + 1
  конец
  вернуть итог
конец

процедура главная()
  пусть а = [1, 2, 3]
  пусть б = [4, 5, 6]
  вернуть сумма(корреляция(а, б))
конец

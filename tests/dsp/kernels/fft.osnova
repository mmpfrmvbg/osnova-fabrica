// БПФ radix-2, N = 4 (ядро DSP, целочисленное и ТОЧНОЕ).
//
// Задача: X[k] = сумма по n: x[n] * W^(n*k), где W = e^(-2*pi*i/4) = -i.
//
// Почему N = 4 и почему это честное БПФ: при N = 4 все поворотные множители равны
// 1 или -i, то есть умножение на W — это перестановка и смена знака, без округления.
// Поэтому результат ЦЕЛОЧИСЛЕННЫЙ и совпадает с эталоном точно. Для N = 8 нужен
// множитель cos(pi/4) = 0.707… — он не представим целым, и потребовалось бы
// масштабирование (тогда эталон обязан повторять ту же схему округления).
//
// Структура — две ступени radix-2:
//   ступень 1 (пары с шагом 2): (x0+x2), (x0-x2), (x1+x3), (x1-x3)
//   ступень 2 (пары с шагом 1):
//     X0 = (x0+x2) + (x1+x3)
//     X2 = (x0+x2) - (x1+x3)
//     X1 = (x0-x2) - i*(x1-x3)  ->  Re = x0-x2,      Im = -(x1-x3)
//     X3 = (x0-x2) + i*(x1-x3)  ->  Re = x0-x2,      Im = +(x1-x3)
//
// Вход: x = [1, 2, 3, 4].
// Возврат: сумма всех восьми чисел (Re и Im всех четырёх выходов) — свёртка
// результата в одно число.
//
// Эталон: tests/dsp/reference.py
// Шапки `модуль ЯдроБПФ` нет: канон языка — файл = модуль (§13.3 docs/language-v2.md).

процедура бпф4(вход)
  пусть выход = []
  пусть x0 = система.массив.получить(вход, 0)
  пусть x1 = система.массив.получить(вход, 1)
  пусть x2 = система.массив.получить(вход, 2)
  пусть x3 = система.массив.получить(вход, 3)

  // ступень 1: пары с шагом 2
  пусть s02 = x0 + x2
  пусть d02 = x0 - x2
  пусть s13 = x1 + x3
  пусть d13 = x1 - x3

  // ступень 2: выходы (вещественная и мнимая части)
  система.массив.добавить(выход, s02 + s13)   // X0, Re
  система.массив.добавить(выход, 0)           // X0, Im
  система.массив.добавить(выход, d02)         // X1, Re
  система.массив.добавить(выход, 0 - d13)     // X1, Im
  система.массив.добавить(выход, s02 - s13)   // X2, Re
  система.массив.добавить(выход, 0)           // X2, Im
  система.массив.добавить(выход, d02)         // X3, Re
  система.массив.добавить(выход, d13)         // X3, Im
  вернуть выход
конец

процедура сумма(значения)
  пусть итог = 0
  пусть i = 0
  пусть длина = система.массив.длина(значения)
  пока i < длина
    итог = итог + система.массив.получить(значения, i)
    i = i + 1
  конец
  вернуть итог
конец

процедура главная()
  пусть вход = [1, 2, 3, 4]
  вернуть сумма(бпф4(вход))
конец

# Скопируйте в forge/.env и заполните. Реальный forge/.env не коммитьте.
# Секреты можно дублировать в корневом .env репозитория — forge их подхватит после forge/.env.

OSNOVA_PROJECT=d:/path/to/osnova-fabrica
OSNOVA_FORGE=d:/path/to/osnova-fabrica/forge

GH_TOKEN=
GHREPO=owner/repo

QWENBIN=qwen
CURSORBIN=agent
# Windows: (Get-Command agent).Source часто agent.ps1 — реальный вход: node.exe + versions/<ver>/index.js.
# forge сам выставляет CURSOR_AGENT_NODE + CURSOR_AGENT_INDEX_JS (обход shims под Git Bash). Отключить: FORGE_SMITH_USE_CURSOR_SHIM=1
# FORGE_SMITH_USE_CURSOR_SHIM=0
# Сколько раз повторить вызов Qwen, если ответ не YAML/JSON (по умолчанию 1 повтор = 2 попытки всего)
# FORGE_ATOMIZER_RETRIES=1
# Промпт атомайзера через stdin (-p -), иначе в argv — на Windows длинный EPIC обрезается (~8191 симв)
# FORGE_ATOMIZER_USE_STDIN=1
# Если Qwen так и не вернул список ATM — собрать атомы из EPIC (scope) без LLM (1..5 шагов)
# FORGE_ATOMIZER_FALLBACK=1

# --- Cursor: только CLI (бинарь agent), отдельного «Cursor HTTP API» в forge нет ---
# smith вызывает CURSORBIN с флагами headless: -p --yolo --trust --workspace (cursor.com/docs/cli/headless).
# Не путать с интерактивом: `agent say hello` (без -p) открывает TUI («Add a follow-up») — forge так не делает.
# Нужен установленный CLI (cursor.com/docs/cli/installation) и вход: `agent login` под тем же пользователем, что и python forge.
# CURSOR_API_KEY — не замена CLI: это опциональная переменная, которую сам бинарь `agent` подхватывает без интерактивного login (часто CI). На своей машине обычно хватает `agent login`.
# CURSOR_API_KEY=
# Проверка из OSNOVA_PROJECT: agent -p --yolo --trust --workspace . "reply with one word: ok"
# Модели smith.sh (через пробел): "_" = без флага --model; при ошибке auto на Windows задайте явную модель
# SMITH_MODELS=_ auto
# SMITH_TIMEOUT=300
# Вывод Cursor/agent в лог forge построчно (1=да). 0 = старый режим: весь вывод только в конце.
# FORGE_SMITH_STREAM=1
# Пока smith.sh жив, каждые N секунд строка «agent still running» (если CLI молчит — видно, не завис ли процесс). 0 = отключить.
# FORGE_SMITH_HEARTBEAT_SEC=60

# Heart (python forge/heart.py): считать forge мёртвым, если heartbeat старше N секунд (по умолчанию 300)
# Пока идёт эпик, forge обновляет heartbeat ~раз в 60 с отдельным потоком — можно оставить 300.
# HEART_MAX_SILENCE=300
# Повторять длинную подсказку для Windows без auto-restart не чаще чем раз в N сек (по умолчанию 900)
# HEART_STALE_HINT_INTERVAL=900

# Windows: автоперезапуск forge при протухшем heartbeat (иначе heart только логирует).
# Укажите свою команду: Task Scheduler, nssm, или пример под свой путь:
# FORGE_RESTART_CMD=cmd /c "cd /d D:\PROJECTS\OSNOVA-FABRIKA && start \"\" /MIN python forge\forge.py"

# Reviewer (Windows): по умолчанию NODE_OPTIONS родителя сбрасывается перед `done` (часто чинит Vitest).
# FORGE_REVIEWER_KEEP_NODE_OPTIONS=1
# Отключить автодобавление --pool=forks и подстановку node …/vitest.mjs
# FORGE_REVIEWER_RAW_DONE=1
# Windows: не подменять стандартный vitest done на npm (argv: cmd /c npm run -s test:forge:done)
# FORGE_REVIEWER_NO_NPM_VITEST=1

# Если эпик взят из epic-queue.txt и все ATM упали (0 OK) — снова добавить номер issue в начало очереди
# FORGE_REQUEUE_FAILED_QUEUE_EPIC=0

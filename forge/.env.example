# Скопируйте в forge/.env и заполните. Реальный forge/.env не коммитьте.
# Секреты можно дублировать в корневом .env репозитория — forge их подхватит после forge/.env.

# Windows: UTF-8 для stdout/stderr Python (иначе в логах и GitHub может быть «мусор» вместо русского текста).
# PYTHONUTF8=1

OSNOVA_PROJECT=d:/path/to/osnova-fabrica
OSNOVA_FORGE=d:/path/to/osnova-fabrica/forge

# Параллельные ATM: отдельные git worktree ``.forge-worker-N`` (default 1 = по одному ATM). Ширина волны ≤ min(OSNOVA_MAX_PARALLEL, FORGE_PARALLEL_WORKERS).
# FORGE_PARALLEL_WORKERS=1
# OSNOVA_MAX_PARALLEL=3
# Несколько Qwen Code в разных cwd: при конфликте за ~/.qwen задайте разные QWEN_HOME или XDG_CONFIG_HOME на воркер (см. доку Qwen Code CLI).

# Атомайзер: cursor (default) дробит EPIC через Cursor CLI; qwen — только Qwen. При недоступности Cursor — автофоллбэк на Qwen.
# FORGE_ATOMIZER_ENGINE=cursor
# Таймаут subprocess Cursor-атомайзера (сек); default max(FORGE_ATOMIZER_TIMEOUT, 300)
# FORGE_ATOMIZER_CURSOR_TIMEOUT=600

GH_TOKEN=
GHREPO=owner/repo

QWENBIN=qwen
# Qwen Code CLI (smith): headless только с -p (см. qwen-code-docs Headless). В коде дефолт FORGE_QWEN_CODE_PROMPT_VIA=dash_p (через forge_dotenv_setting).
# Явно: FORGE_QWEN_CODE_PROMPT_VIA=dash_p — то же. Только отладка: positional (без -p, может уйти в чат).
# FORGE_QWEN_CODE_PROMPT_VIA=dash_p
# FORGE_QWEN_CODE_PROMPT_VIA=positional
# FORGE_QWEN_ALLOWED_TOOLS=write_file,edit,read_file,run_shell_command,grep_search,glob
# FORGE_QWEN_MAX_SESSION_TURNS=10
# Если Qwen-исполнитель вернул BLK / quota — повторить тот же ATM через Cursor smith. 0 = выкл. (старое имя: FORGE_QWEN_QUOTA_FALLBACK)
# FORGE_QWEN_CURSOR_FALLBACK=1
# FORGE_QWEN_QUOTA_FALLBACK=1
# Дневной лимит Qwen: раздельно для исполнителя (qwenexec, reviewer) и для атомайзера (Qwen fallback). Если задан только FORGE_QWEN_DAILY_LIMIT — оба лимита берутся из него (как раньше).
# FORGE_QWEN_EXECUTOR_DAILY_LIMIT=1000
# FORGE_QWEN_ATOMIZER_DAILY_LIMIT=200
# FORGE_QWEN_DAILY_LIMIT=1000
# heart.py: предупреждение в лог при ≥85% дневного лимита (интервал между повторами, сек)
# FORGE_QWEN_BUDGET_WARN_THRESHOLD=0.85
# FORGE_QWEN_BUDGET_WARN_INTERVAL=3600
# Атомайзер: FORGE_ATOMIZER_TIMEOUT — только оболочка subprocess.run; внутри qwen-code есть свой лимит streaming (~45s по умолчанию).
# При «Streaming request timeout after 45s» поднимите contentGenerator.timeout в ~/.qwen/settings.json или .qwen/settings.json в репо (мс), см. qwen-code docs.
# FORGE_ATOMIZER_TIMEOUT=180
CURSORBIN=agent
# Windows: (Get-Command agent).Source часто agent.ps1 — реальный вход: node.exe + versions/<ver>/index.js.
# forge сам выставляет CURSOR_AGENT_NODE + CURSOR_AGENT_INDEX_JS (обход shims под Git Bash). Отключить: FORGE_SMITH_USE_CURSOR_SHIM=1
# FORGE_SMITH_USE_CURSOR_SHIM=0
# Windows: smith без Git Bash — node + index.js напрямую из Python (как в PowerShell). Старый путь через smith.sh: FORGE_SMITH_NATIVE_WIN32=0
# FORGE_SMITH_NATIVE_WIN32=1
# Сколько раз повторить вызов Qwen, если ответ не YAML/JSON (по умолчанию 1 повтор = 2 попытки всего)
# FORGE_ATOMIZER_RETRIES=1
# Промпт атомайзера через stdin (-p -), иначе в argv — на Windows длинный EPIC обрезается (~8191 симв)
# FORGE_ATOMIZER_USE_STDIN=1
# Если Qwen так и не вернул список ATM — собрать атомы из EPIC (scope) без LLM (1..5 шагов)
# FORGE_ATOMIZER_FALLBACK=1
# Ревьюер (Qwen после smith): промпт с git diff через stdin (-p -), иначе на Windows WinError 206 при длинном diff
# FORGE_QWEN_REVIEW_USE_STDIN=1

# --- Cursor: только CLI (бинарь agent), отдельного «Cursor HTTP API» в forge нет ---
# smith вызывает CURSORBIN с флагами headless: -p --yolo --trust --workspace (cursor.com/docs/cli/headless).
# Не путать с интерактивом: `agent say hello` (без -p) открывает TUI («Add a follow-up») — forge так не делает.
# Нужен установленный CLI (cursor.com/docs/cli/installation) и вход: `agent login` под тем же пользователем, что и python forge.
# CURSOR_API_KEY — не замена CLI: это опциональная переменная, которую сам бинарь `agent` подхватывает без интерактивного login (часто CI). На своей машине обычно хватает `agent login`.
# CURSOR_API_KEY=
# Проверка из OSNOVA_PROJECT: agent -p --yolo --trust --workspace . "reply with one word: ok"
# Модели smith.sh (через пробел): "_" = без флага --model; при ошибке auto на Windows задайте явную модель
# SMITH_MODELS=_ auto
# SMITH_TIMEOUT=300 (used only when FORGE_SMITH_NO_INNER_TIMEOUT=0; Windows defaults to no inner GNU timeout)
# Windows: внутренний GNU timeout в smith часто даёт ложный 124 при живом node — по умолчанию отключён (см. cursorexec). Вернуть: FORGE_SMITH_NO_INNER_TIMEOUT=0
# FORGE_SMITH_NO_INNER_TIMEOUT=1
# Вывод Cursor/agent в лог forge построчно (1=да). 0 = старый режим: весь вывод только в конце.
# FORGE_SMITH_STREAM=1
# Пока smith.sh жив, каждые N секунд строка «agent still running» (если CLI молчит — видно, не завис ли процесс). 0 = отключить.
# FORGE_SMITH_HEARTBEAT_SEC=60

# Heart (python forge/heart.py): считать forge мёртвым, если heartbeat старше N секунд (по умолчанию 300)
# Пока идёт эпик, forge обновляет heartbeat ~раз в 60 с отдельным потоком — можно оставить 300.
# HEART_MAX_SILENCE=300
# Повторять длинную подсказку для Windows без auto-restart не чаще чем раз в N сек (по умолчанию 900)
# HEART_STALE_HINT_INTERVAL=900

# Windows: автоперезапуск forge при протухшем heartbeat (иначе heart только логирует).
# Укажите свою команду: Task Scheduler, nssm, или пример под свой путь:
# FORGE_RESTART_CMD=cmd /c "cd /d D:\PROJECTS\OSNOVA-FABRIKA && start \"\" /MIN python forge\forge.py"

# После Qwen Code smith агент уже запускал `done` — не повторять vitest в reviewer (1=да).
# FORGE_REVIEWER_SKIP_DONE_AFTER_QWEN=1
# Reviewer (Windows): по умолчанию NODE_OPTIONS родителя сбрасывается перед `done` (часто чинит Vitest).
# FORGE_REVIEWER_KEEP_NODE_OPTIONS=1
# Отключить автодобавление --pool=forks и подстановку node …/vitest.mjs
# FORGE_REVIEWER_RAW_DONE=1
# Windows: не подменять стандартный vitest done на npm (argv: cmd /c npm run -s test:forge:done)
# FORGE_REVIEWER_NO_NPM_VITEST=1

# Если эпик взят из epic-queue.txt и все ATM упали (0 OK) — снова добавить номер issue в начало очереди
# FORGE_REQUEUE_FAILED_QUEUE_EPIC=0

# --- v5.3: observability, GitHub poll, TTL, BLK retries, optional CI-gated close ---
# brain_source в логах/ретро: queue | socket | github_poll | fallback_local | idle
# Опрос открытых Issues с меткой EPIC, если очередь+сокет пусты (нужен GH_TOKEN). По умолчанию включено (1).
# FORGE_POLL_OPEN_BRAIN_EPICS=0
# Резервный Qwen-планировщик: промпт через stdin (-p -), иначе на Windows WinError 206 при длинном -p
# FORGE_BRAIN_FALLBACK_QWEN_USE_STDIN=1
# FORGE_BRAIN_EPIC_LABEL=brain-epic
# FORGE_EPIC_SKIP_LABELS=blocker,forge-stale
# TTL «зависшего» lock в forge-state.json (секунды); по истечении — комментарий + метка forge-stale
# FORGE_EPIC_TTL_SECONDS=10800
# После N permanent BLK на issue — метка retry-exhausted
# FORGE_ISSUE_ATTEMPTS_MAX=3
# Ретро: не закрывать issue при OK/PARTIAL, а ждать зелёного CI (см. ci.yml job forge-close-pending-ci)
# FORGE_RETRO_REQUIRE_CI=0

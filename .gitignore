# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs
*.log
logs/

# TypeScript build output
dist/
build/
out/

# Compiler generated artifacts
src/compiler/generated/*.js
src/compiler/generated/*.json
src/compiler/generated/*.osvbc
!src/compiler/generated/.gitkeep

# Runtime artifacts
src/runtime/generated/
*.osvbc.json.tmp

# Environment
.env
.env.local
.env.*.local
!.env.example
!**/.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/
.nyc_output/

# vitest
.vitest-cache/

# Сырые внешние источники кодировки e2k (binutils/LLVM/QEMU/elbrus-docs):
# сотни мегабайт, в репозиторий не попадают. Опись — docs/e2k-sources-raw.md,
# сверка описи с копией — src/scripts/e2kSources.audit.test.ts.
.tmp/e2k-sources/

# Batch run results
runs/*
# decisions.jsonl tracked intentionally
!runs/decisions.jsonl
# health snapshots committed by Health Snapshot workflow
!runs/health-snapshots/
!runs/health-snapshots/**

# Center temp files
center-out.txt
center-err.txt

# Forge parallel worktrees (git worktree add .forge-worker-N)
.forge-worker-*/
.forge-worktrees/
.worktrees/

# Extra batch task files
src/scripts/batch-tasks-*.txt
!src/scripts/batch-tasks.txt

# Osiris app (apps/osiris)
apps/osiris/osiris.db
apps/osiris/node_modules/
apps/osiris/.env

.qwen/oauth_creds.json

.qwen/oauth_creds*.json

# Проектные навыки DSH: .dsh/skills — junction на .cursor/skills.
# Игнорируем только связь, чтобы .dsh остался доступен для версионируемой
# конфигурации (например, .dsh/roles/*.yml).
.dsh/skills

# SSH-доступ к железу МЦСТ: приватный ключ и его OpenSSH-копия.
# Приватные ключи в репозиторий не попадают никогда — ни в каком формате.
Ssh_private_mcst_key.ppk
key.openssh
*.openssh

# Отчёты о доступе к железу МЦСТ: локальные, содержат данные доступа
# (имя хоста, логин, порт) — публикации не подлежат.
.tmp/mcst-*.md


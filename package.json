{
  "name": "osnova-fabrica",
  "version": "0.1.1",
  "description": "Кодогенератор для языка Основа: LLM → .osnova → .osvbc → VM",
  "private": true,
  "bin": {
    "osnova": "dist/cli.js",
    "osnova-fabrica": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "vitest run --reporter=default --reporter=json --outputFile=.tmp/vitest-report.json && npm run check:test-files && npm run check:language-schema",
    "check:test-files": "tsx src/scripts/testFiles.audit.ts",
    "test:e2e-osiris": "vitest run --config vitest.e2e.config.ts",
    "coverage": "vitest run --coverage --coverage.exclude=src/agents/RepairEngineer.ts --coverage.exclude=src/pipeline-llm/buildOsnovaPrompt.ts --exclude src/agents/RepairEngineer.test.ts",
    "test:watch": "vitest",
    "test:forge": "python -m unittest discover -s forge/tests -p \"test_*.py\"",
    "golden": "tsx src/runtime/goldenApps.ts",
    "compile:fixtures": "tsx src/compiler/compile-fixtures.ts",
    "report:deprecated-end": "tsx src/scripts/deprecatedEndReport.ts",
    "export:schema": "tsx src/compiler/export-language-schema.ts",
    "generate:language-schema": "tsx scripts/generate-language-schema.ts",
    "check:language-schema": "tsx scripts/check-language-schema.ts",
    "check:yaml-drift": "tsx src/scripts/check-yaml-drift.ts",
    "docs:check": "tsx src/scripts/doc-guardian.ts",
    "docs:index": "tsx src/scripts/doc-guardian.ts --fix",
    "check:epic-scope": "tsx scripts/check-epic-scope.ts",
    "artifacts:check": "tsx scripts/rebuild-artifacts.ts",
    "artifacts:rebuild": "tsx scripts/rebuild-artifacts.ts --write",
    "gate:determinism": "vitest run && vitest run --sequence.shuffle --sequence.seed=1 && vitest run --sequence.shuffle --sequence.seed=42",
    "gate:reorder": "tsx src/scripts/reorder-gate.ts",
    "gate:reorder:stderr": "tsx src/scripts/reorder-gate.ts 2>&1",
    "gate:pack": "tsx src/scripts/pack-gate.ts",
    "gate:pack:negative": "tsx src/scripts/pack-gate-negative.ts",
    "gate:qemu": "vitest run --config vitest.qemu.config.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "validate:spec": "tsx src/compiler/validate-language-registry.ts",
    "osnova-language:validate": "npx tsx src/compiler/validate-language-registry.ts",
    "ci": "npm --prefix apps/osiris ci --no-audit && npm run typecheck && npm test && npm run lint && npx tsx src/scripts/check-yaml-drift.ts && npm run docs:check && cross-env OSNOVA_STORAGE_ROOT=/tmp/osnova-storage-ci npm run golden && npm run gate:reorder && npm run report:deprecated-end && npm run validate:spec && cross-env OSNOVA_STORAGE_ROOT=/tmp/osnova-storage-ci npm run coverage",
    "osnova-mini-os:e2e": "tsx src/scripts/osnova-mini-os-e2e.ts",
    "traces": "tsx src/scripts/trace-viewer.ts",
    "center": "tsx src/center/index.ts",
    "osnova": "tsx src/cli/index.ts",
    "batch": "tsx src/scripts/batch-run.ts",
    "batch-run": "tsx src/scripts/batch-run.ts",
    "loop": "tsx src/cli.ts loop",
    "improve": "tsx src/cli.ts improve",
    "resident": "tsx src/cli.ts resident",
    "shadow-report": "tsx src/scripts/aggregate-shadow.ts",
    "export-dataset": "tsx src/scripts/export-dataset.ts",
    "export-dataset-v2": "npx tsx src/tools/export-dataset-v2.ts",
    "dataset-stats": "npx tsx src/tools/dataset-stats.ts",
    "submit-finetune": "npx tsx src/tools/submit-finetune.ts",
    "submit-finetune:dry": "npx tsx src/tools/submit-finetune.ts --dry-run",
    "analyze-dataset-health": "tsx src/scripts/analyze-dataset-health.ts",
    "analyze-language-health": "tsx src/scripts/analyze-language-health.ts",
    "patch-legacy-traces": "tsx src/scripts/patch-legacy-traces.ts",
    "analyze-health-extended": "npx tsx src/tools/health-metrics-extended.ts --json",
    "beta-gate": "npx tsx src/scripts/beta-gate.ts",
    "osiris": "tsx apps/osiris/src/index.ts",
    "llm-usage-report": "python3 scripts/llm_usage_report.py",
    "llm-usage-report:notg": "python3 scripts/llm_usage_report.py --no-telegram",
    "blame-mode-bisect": "npx tsx scripts/blame-mode-bisect.ts",
    "report-to-pm": "npx tsx scripts/report-to-pm.ts",
    "weekly-health-diff": "npx tsx src/tools/weekly-health-diff.ts",
    "weekly-health-diff:notg": "npx tsx src/tools/weekly-health-diff.ts --no-telegram",
    "health-diff": "npx tsx src/tools/health-diff.ts",
    "health-diff:notg": "npx tsx src/tools/health-diff.ts --no-telegram",
    "cvt-snapshot": "tsx src/intelligence/sources/hh.ts",
    "cvt-weekly-report": "npx tsx src/intelligence/sources/cvt-weekly.ts",
    "cvt-weekly-report:notg": "npx tsx src/intelligence/sources/cvt-weekly.ts --no-telegram --no-fetch",
    "ab-prompt-test": "npx tsx src/tools/ab-prompt-test.ts",
    "intelligence-collect": "npx tsx src/intelligence/collector.ts",
    "intelligence-digest": "npx tsx src/intelligence/digest.ts",
    "intelligence-digest:notg": "npx tsx src/intelligence/digest.ts --no-telegram",
    "pipeline:metrics": "npx tsx scripts/pipeline-metrics.ts --file ./osiris.out.log --days 7",
    "get-version": "node scripts/get-version.mjs",
    "atm": "tsx src/atm/cli.ts",
    "atm:report": "tsx src/atm/cli.ts report .osnova/epics/EPK-260327-001",
    "test:forge:compiler": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts --pool=threads --maxWorkers=1 --no-file-parallelism --no-isolate src/compiler/",
    "test:forge:agents": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts --pool=threads --maxWorkers=1 --no-file-parallelism --no-isolate src/agents/",
    "test:forge:done": "npm run -s test:forge:compiler && npm run -s test:forge:agents"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "js-yaml": "^4.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-env": "^10.1.0",
    "prettier": "^3.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.2"
  }
}

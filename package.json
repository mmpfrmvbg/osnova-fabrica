{
  "name": "osnova-fabrica",
  "version": "0.1.1",
  "description": "Кодогенератор для языка Основа: LLM → .osnova → .osvbc → VM",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden": "tsx src/runtime/goldenApps.ts",
    "compile:fixtures": "tsx src/compiler/compile-fixtures.ts",
    "validate:spec": "tsx src/validateSpec.ts",
    "export:schema": "tsx src/compiler/export-language-schema.ts"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  }
}

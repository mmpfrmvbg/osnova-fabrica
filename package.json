{
  "name": "osnova-fabrica",
  "version": "0.1.1",
  "description": "Кодогенератор для языка Основа: LLM → .osnova → .osvbc → VM",
  "private": true,
  "bin": {
    "osnova": "dist/cli.js",
    "osnova-fabrica": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden": "tsx src/runtime/goldenApps.ts",
    "compile:fixtures": "tsx src/compiler/compile-fixtures.ts",
    "export:schema": "tsx src/compiler/export-language-schema.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "validate:spec": "tsx src/compiler/validate-language-registry.ts",
    "ci": "npm run typecheck && npm test && npm run lint && npm run golden",
    "osnova-mini-os:e2e": "tsx src/scripts/osnova-mini-os-e2e.ts"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  }
}

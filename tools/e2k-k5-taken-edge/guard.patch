+/**
+ * ОРАКУЛ: ЗВУЧНОСТЬ ПАРЫ «СРАВНЕНИЕ → УСЛОВНЫЙ ПЕРЕХОД» НА РЕБРЕ ВЗЯТОГО ПЕРЕХОДА (K5, срез A4-5).
+ *
+ * # Что здесь стережётся и почему это худший класс
+ *
+ * Окно живости значения в `pairPredicates` считалось по ЛИНЕЙНОМУ потоку: жизнь кончалась на
+ * следующей записи того же регистра. Для РЕБРА ВЗЯТОГО перехода это неверно — инструкции между
+ * переходом и его целью на этом ребре НЕ исполняются, поэтому регистр приходит на цель со значением,
+ * записанным ДО перехода. Пара составлялась, значение выбрасывалось, и на цель приходил МУСОР.
+ *
+ * **Замер на модели (2026-10-29, `.tmp/k5-silent-lie.ts`):** `если а >= 10 и а <= 20` при `а = 5`
+ * возвращало код **7** вместо **3** — отказов 0, образ собран, число неверное. Это не отказ, а
+ * тихая ложь: класс, названный худшим в `AGENTS.md`.
+ *
+ * # Причина: один `ct` на два ребра склейки
+ *
+ * Все пары носят ОДИН предикат (`{@link PREDICATE_FOR_PAIRS}`), а «склейка» короткого замыкания —
+ * условный переход, на который сходятся ДВА ребра: своё (после второго сравнения) и ребро первого
+ * перехода (второе сравнение пропущено). На первом ребре предикат несёт значение ВТОРОГО сравнения,
+ * на втором — ПЕРВОГО, и один статически выбранный `ct` не выражает оба:
+ *
+ * | форма | первое сравнение | `ct` пары 1 | склейка | вердикт |
+ * |---|---|---|---|---|
+ * | `если A и B` | `IR.ge` (перевёрнуто) | `0x40` | `0x60` | **РАСХОДЯТСЯ → отказ** |
+ * | `пока A и B` | `IR.lt` | `0x60` | `0x60` | совпадают → звучит |
+ * | `если A или B` | `IR.eq` | `0x40` | `0x60` | совпадают → звучит |
+ * | `пока A или B` | `IR.lt` | `0x40` | `0x40` | совпадают → звучит |
+ *
+ * Три «звучащих» формы — это ровно те, что стоят в корпусе и проверены железом (38/38): примеры 24,
+ * 28, 35, 46. Поэтому правка НЕ трогает ни корпус, ни пять ядер (закреплённые числа 458 / 53 / 511,
+ * покрытие 413, FIR 181 — замер `.tmp/k5-precise-impact.ts`: в пяти ядрах незвучных пар **0**).
+ *
+ * # Цена правки (замер, не оценка)
+ *
+ * | где | до | после |
+ * |---|---|---|
+ * | шёстистрочное репро K5 | 1 отказ | **3** (снята ещё и пара, значение которой возвращалось) |
+ * | тело лексера | 141 отказ | **157** (предикатных 11 → 27) |
+ * | корпус без отказов | 44 | **43** (пример 24 — форма незвучна, вход её ребра не задевал) |
+ * | пять ядер | 14 пар / 0 отказов | **14 пар / 0 отказов** |
+ *
+ * # Негативный контроль (измерено 2026-10-29)
+ *
+ * Откат правки (`git checkout -- src/e2k/predicatePairing.ts`) краснит **ровно 5** проверок этого
+ * файла — обе проверки репро, обе проверки склейки, проверку «значение на ребре» и поведенческую
+ * пробу тихой лжи; проба при откате собирает образ и отдаёт **7** вместо отказа. Файл возвращён из
+ * `.tmp/k5-predicatePairing.fixed.ts` со сверкой sha256; замер — в отчёте лида.
+ *
+ * # Чего правка НЕ делает
+ *
+ * Она НЕ снимает отказ K5: репро по-прежнему отказывает — сравнение нельзя понизить, когда его
+ * значение нужно КАК ЗНАЧЕНИЕ (предикат значения не несёт). Это отдельная работа: перенос булева
+ * значения в регистр (`cmp*` + predicated `movts 0/1`) требует новой формы носителя, а форма
+ * известна раскладке ДО плоскости (`twoPassLayout#carrierFormWithReason`, §3.135) — то есть выходит
+ * за `src/e2k/predicatePairing.ts`. Дерево решений: **ветка В**, K5 — в срез 5а.
+ */
+import { describe, it, expect } from 'vitest';
+import { parseV3 } from '../compiler-v3/index';
+import { loweredProgram } from './programImage';
+import {
+  CTCOND_NEG_PRED,
+  CTCOND_PRED,
+  PREDICATE_FOR_PAIRS,
+  pairPredicates,
+  type PredicatePair,
+} from './predicatePairing';
+import type { AsmInstruction, Operand } from './backend';
+
+const ФАЙЛ = 'проба.osnova';
+const reg = (index: number): Operand => ({ kind: 'reg', index });
+const imm = (value: number): Operand => ({ kind: 'imm', value });
+const ir = (mnemonic: string, operands: readonly Operand[]): AsmInstruction => ({ mnemonic, channel: 0, operands });
+
+/** Понизить программу и вернуть отказы (текстом): тот же путь, что у конвейера цели. */
+function отказы(источник: string): readonly string[] {
+  const р = parseV3(источник, ФАЙЛ);
+  expect(р.errors, 'разбор программы').toEqual([]);
+  return loweredProgram(источник, {
+    filename: ФАЙЛ,
+    parse: () => ({ ast: р.program ?? null, errors: р.errors }),
+  }).refused.map((отказ) => `${отказ.code}: ${отказ.reason}`);
+}
+
+/**
+ * Форма «склейки короткого замыкания» в носителях: сравнение → переход на ВТОРОЕ сравнение,
+ * второе сравнение → переход на выход. Первое сравнение задаётся именем и первым переходом.
+ */
+function склейка(
+  первоеСравнение: string,
+  первыйПереход: 'IR.jmp_if' | 'IR.jmp_if_not',
+): readonly AsmInstruction[] {
+  return [
+    ir(первоеСравнение, [reg(1), reg(2), reg(3)]),
+    ir(первыйПереход, [reg(1), imm(3)]), // ребро 1 ведёт НА склейку (#3)
+    ir('IR.lt', [reg(1), reg(2), reg(4)]),
+    ir('IR.jmp_if_not', [reg(1), imm(5)]), // склейка: цель #5
+    ir('IR.const', [reg(5), imm(0)]), // заполнитель: значение не читает
+    ir('IR.const', [reg(6), imm(0)]),
+  ];
+}
+
+describe('K5: репро из задания — отказ назван, а не подменён', () => {
+  /**
+   * ШЕСТЬ СТРОК ИЗ ЗАДАНИЯ. Отказ НЕ снят: значение последнего сравнения возвращается, а предикат
+   * значения не несёт. Ключевое в правке — что отказ называет ОБЕ стороны: и `IR.le` (значение
+   * нужно как значение), и `IR.ge` (значение живо на ребре взятого перехода).
+   */
+  const РЕПРО = [
+    'процедура цифра(код: Число) → Логический',
+    '  вернуть код >= 48 и код <= 57',
+    'конец',
+    'действие главная()',
+    '  вернуть 0',
+    'конец',
+    '',
+  ].join('\n');
+
+  it('отказ ровно один вид: OSN-LOW-004, и он НЕ подменён на «нет формы»', () => {
+    const найденные = отказы(РЕПРО);
+    expect(найденные.length, 'отказов у шестистрочного репро').toBe(3);
+    for (const отказ of найденные) expect(отказ, 'код отказа').toMatch(/^OSN-LOW-004: /);
+  });
+
+  it('названо, что значение последнего сравнения нужно КАК ЗНАЧЕНИЕ', () => {
+    const найденные = отказы(РЕПРО);
+    const проLe = найденные.find((отказ) => отказ.includes('«IR.le»'));
+    expect(проLe, 'отказ на IR.le не назван').toBeDefined();
+    expect(проLe, 'не сказано, что читатель — не условие перехода').toMatch(
+      /единственный читатель результата — #\d+ IR\.ret, и это не чтение условия перехода/,
+    );
+  });
+
+  it('названо, что значение первого сравнения живо на РЕБРЕ взятого перехода', () => {
+    const найденные = отказы(РЕПРО);
+    const проGe = найденные.find((отказ) => отказ.includes('«IR.ge»'));
+    expect(проGe, 'отказ на IR.ge не назван — значение возвращалось бы мусором').toBeDefined();
+    expect(проGe, 'причина не названа').toMatch(/значение живо на ребре перехода/);
+    expect(проGe, 'не сказано, что цель читает регистр как значение').toMatch(/читает %r\d+ как ЗНАЧЕНИЕ/);
+  });
+});
+
+describe('K5: склейка короткого замыкания — звучит или нет, по ЗАМЕРУ', () => {
+  it('`если A и B` при A из `ge` (перевёрнутое условие) — отказ: один ct не выражает два ребра', () => {
+    const pairing = pairPredicates(склейка('IR.ge', 'IR.jmp_if_not'));
+    expect(pairing.pairs.map((пара) => пара.comparisonIndex), 'незвучная пара осталась составленной').toEqual([2]);
+    const причина = pairing.refusals.find((отказ) => отказ.index === 0)?.reason ?? '';
+    expect(причина, 'причина не названа').toMatch(/значение живо на ребре перехода/);
+    expect(причина, 'не названа склейка').toMatch(/«склейка» IR\.jmp_if_not/);
+    expect(причина, 'не сказано, что миры расходятся').toMatch(/мир значений: скачок=true, предикатный=false/);
+    // Осиротевший переход обязан получить СВОЙ отказ, а не остаться молча непереданным.
+    expect(pairing.refusals.map((отказ) => отказ.index), 'осиротевший переход не назван').toContain(1);
+    expect(pairing.refusals.map((отказ) => отказ.index), 'осиротевшее сравнение не названо').toContain(0);
+  });
+
+  it('`пока A и B` (A из `lt`) — ЗВУЧИТ: оба ребра дают одно решение', () => {
+    const pairing = pairPredicates(склейка('IR.lt', 'IR.jmp_if_not'));
+    expect(pairing.refusals, 'звучная форма отвергнута — регрессия на корпусе 28/24').toEqual([]);
+    expect(pairing.pairs.length, 'пар у формы').toBe(2);
+    expect(pairing.pairs.map((пара) => пара.condition)).toEqual([CTCOND_NEG_PRED, CTCOND_NEG_PRED]);
+  });
+
+  it('`если A или B` (A из `eq`) — ЗВУЧИТ', () => {
+    const pairing = pairPredicates(склейка('IR.eq', 'IR.jmp_if'));
+    expect(pairing.refusals, 'звучная форма отвергнута — регрессия на корпусе 35').toEqual([]);
+    expect(pairing.pairs.length, 'пар у формы').toBe(2);
+    expect(pairing.pairs[0]!.condition, 'первая пара `или`').toBe(CTCOND_PRED);
+  });
+
+  it('`пока A или B` (A из `lt`) — ЗВУЧИТ, хотя у обеих пар один и тот же код условия', () => {
+    const pairing = pairPredicates(склейка('IR.lt', 'IR.jmp_if'));
+    expect(pairing.refusals, 'звучная форма отвергнута — регрессия на корпусе 46').toEqual([]);
+    expect(pairing.pairs.length, 'пар у формы').toBe(2);
+  });
+});
+
+describe('K5: значение, живое на ребре — отказ; мёртвое — пара', () => {
+  it('цель читает регистр как значение (`IR.ret`) — отказано, причина названа', () => {
+    // Поток повторяет форму репро: запись того же регистра между переходом и целью закрывает
+    // ЛИНЕЙНОЕ окно живости, поэтому пара составляется — а на ребре взятого перехода #1 эта
+    // запись пропущена, и цель #3 читает значение, записанное ДО перехода.
+    const pairing = pairPredicates([
+      ir('IR.ge', [reg(1), reg(2), reg(3)]),
+      ir('IR.jmp_if_not', [reg(1), imm(3)]),
+      ir('IR.le', [reg(1), reg(2), reg(4)]), // конец линейной жизни значения #0
+      ir('IR.ret', [imm(1), reg(1)]), // на ребре взятого #1 здесь ещё значение #0
+    ]);
+    const причина = pairing.refusals.find((отказ) => отказ.index === 0)?.reason ?? '';
+    expect(pairing.pairs.map((пара) => пара.comparisonIndex), 'пара #0 осталась составленной').not.toContain(0);
+    expect(причина).toMatch(/значение живо на ребре перехода/);
+    expect(причина).toMatch(/цель #3 \(IR\.ret\) читает %r1 как ЗНАЧЕНИЕ/);
+    expect(pairing.refusals.map((отказ) => отказ.index), 'осиротевший переход не назван').toContain(1);
+  });
+
+  it('цель ПЕРЕПИСЫВАЕТ регистр — значение мертво, пара составлена', () => {
+    const pairing = pairPredicates([
+      ir('IR.ge', [reg(1), reg(2), reg(3)]),
+      ir('IR.jmp_if_not', [reg(1), imm(3)]),
+      ir('IR.const', [reg(5), imm(0)]),
+      ir('IR.const', [reg(1), imm(0)]), // та же запись на ребре закрывает жизнь значения
+    ]);
+    expect(pairing.refusals, 'звучная пара отвергнута').toEqual([]);
+    expect(pairing.pairs.map((пара) => пара.comparisonIndex)).toEqual([0]);
+  });
+
+  it('операции с неизвестными операндами на цели — не отказываем (чтения не видно)', () => {
+    const pairing = pairPredicates([
+      ir('IR.ge', [reg(1), reg(2), reg(3)]),
+      ir('IR.jmp_if_not', [reg(1), imm(3)]),
+      ir('IR.const', [reg(5), imm(0)]),
+      ir('IR.unknown_for_test', [reg(1)]),
+    ]);
+    expect(pairing.pairs.map((пара) => пара.comparisonIndex), 'отказ шире доказательства').toEqual([0]);
+  });
+});
+
+describe('K5: поведенческий оракул — тихая ложь стала названным отказом', () => {
+  /**
+   * РАЗЛИЧАЮЩАЯ ПРОБА. До правки это понижалось, собиралось и на модели возвращало **7** вместо
+   * **3** (`.tmp/k5-silent-lie.ts`, замер 2026-10-29). Теперь — отказ с причиной. Проба находится
+   * здесь, а не только в `.tmp`: иначе «починили» никем не стережётся.
+   */
+  const ЛОЖЬ = [
+    'действие главная()',
+    '  пусть а = 5',
+    '  если а >= 10 и а <= 20',
+    '    вернуть 7',
+    '  конец если',
+    '  вернуть 3',
+    'конец',
+    '',
+  ].join('\n');
+
+  it('`если A и B` при ложном A — ОТКАЗ, а не исполнение с неверным числом', () => {
+    const найденные = отказы(ЛОЖЬ);
+    expect(найденные.length, 'программа собралась — значит, число снова может быть неверным').toBeGreaterThan(0);
+    expect(найденные.join('\n'), 'причина не названа').toMatch(/значение живо на ребре перехода/);
+  });
+
+  it('та же форма с НЕперевёрнутым первым условием (`<`) — понижается (граница, не «сломано всё»)', () => {
+    const ЧЕСТНАЯ = ЛОЖЬ.replace('а >= 10 и а <= 20', 'а < 10 и а <= 20');
+    expect(отказы(ЧЕСТНАЯ), 'звучная форма отвергнута').toEqual([]);
+  });
+
+  it('`или` в условии — понижается, как и раньше (регрессия корпуса 35 исключена)', () => {
+    const ИЛИ = ЛОЖЬ.replace('а >= 10 и а <= 20', 'а == 4 или а == 5');
+    expect(отказы(ИЛИ), 'звучная форма `или` отвергнута').toEqual([]);
+  });
+
+  it('два сравнения подряд БЕЗ склейки (обе ветви — свои переходы) — понижаются', () => {
+    const БЕЗ_СКЛЕЙКИ = [
+      'действие главная()',
+      '  пусть а = 5',
+      '  если а < 10 и а <= 20',
+      '    вернуть 7',
+      '  конец если',
+      '  вернуть 3',
+      'конец',
+      '',
+    ].join('\n');
+    expect(отказы(БЕЗ_СКЛЕЙКИ), 'звучная форма отвергнута').toEqual([]);
+  });
+});
+
+describe('K5: закреплённые числа не тронуты', () => {
+  it('пары пяти ядер: 14 пар и ни одного отказа (закреплённые 458 / 53 / 511 держатся)', () => {
+    // Число 14 — из `src/e2k/e2kPredicatePairs.test.ts`; здесь проверяется, что НАША проверка
+    // не сняла ни одной пары ядер. Полный поток ядер гоняет тот файл (замер — 0 незвучных пар).
+    const pairing = pairPredicates([
+      ir('IR.lt', [reg(1), reg(2), reg(3)]),
+      ir('IR.jmp_if_not', [reg(1), imm(4)]),
+      ir('IR.const', [reg(5), imm(0)]),
+      ir('IR.const', [reg(1), imm(0)]),
+    ]);
+    expect(pairing.refusals).toEqual([]);
+    expect(pairing.pairs.length).toBe(1);
+  });
+
+  it('предикат пары — прежний (`PREDICATE_FOR_PAIRS`), личность кода отказа не менялась', () => {
+    const pairing = pairPredicates([
+      ir('IR.lt', [reg(1), reg(2), reg(3)]),
+      ir('IR.jmp_if_not', [reg(1), imm(3)]),
+      ir('IR.const', [reg(1), imm(0)]),
+    ]);
+    const пара: PredicatePair = pairing.pairs[0]!;
+    expect(пара.predicate).toBe(PREDICATE_FOR_PAIRS);
+    expect(пара.condition).toBe(CTCOND_NEG_PRED | PREDICATE_FOR_PAIRS);
+  });
+});
diff --git a/src/e2k/predicatePairing.ts b/src/e2k/predicatePairing.ts
index e0a2d00..f80037b 100644
--- a/src/e2k/predicatePairing.ts
+++ b/src/e2k/predicatePairing.ts
@@ -22,6 +22,23 @@
  * | читателей несколько (в том числе два перехода) | отказ: предикат один |
  * | условие перехода пришло не из сравнения | отказ: предикат взять неоткуда |
  * | в промежутке операции с неизвестными операндами | отказ: живость не доказана |
+ * | значение живо на РЕБРЕ ВЗЯТОГО перехода | отказ: см. §«Ребро взятого перехода» ниже |
+ *
+ * # Ребро взятого перехода: окно живости — ЛИНЕЙНОЕ, а значение течёт и по ребру (K5, 2026-10-29)
+ *
+ * Окно живости выше считается по ЛИНЕЙНОМУ потоку: жизнь значения кончается на следующей записи
+ * того же регистра. Для РЕБРА ВЗЯТОГО перехода это неверно: инструкции между переходом и его целью
+ * на этом ребре **не исполняются**, поэтому регистр приходит на цель со значением, записанным ДО
+ * перехода. Измерено на модели: `если а >= 10 и а <= 20` при `а = 5` возвращало **7** вместо **3** —
+ * отказов 0, образ собран, число неверное (худший класс, `AGENTS.md`). Механизм: пара
+ * «`IR.ge` → `jmp_if_not`» выбрасывала значение, а цель перехода читала тот же регистр.
+ *

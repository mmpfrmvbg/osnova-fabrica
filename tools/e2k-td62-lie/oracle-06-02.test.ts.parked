/**
 * ATOM-06-02-02 (Строка.срез и Строка.склейка РАНТАЙМОВЫХ строк) — ОРАКУЛ, НАПИСАННЫЙ ДО КОДА.
 *
 * ═══ ЗАЧЕМ ОН ЗДЕСЬ, А НЕ В `src/` ═════════════════════════════════════════════════════════════════
 *
 * ОБНОВЛЕНО 2026-11-05 (ATOM-06-02-09): утверждение «`подстрока` понижения не имеет ни на какой
 * глубине» было верным ДО статического среза и сегодня НЕВЕРНО. Проба С1 (срез по доказанной строке с
 * КОНСТАНТНЫМИ краями) переехала в дерево и ЗЕЛЁНАЯ — `src/e2k/stringSliceStatic.test.ts` (11 проб,
 * оба прогона), а на железе 8/8 совпало байт в байт (`docs/hardware-debt.md` §3.174.1). Поэтому С1
 * отсюда УБРАНА: в `src/` красный файл краснит `check:test-files` («проверка вне репозитория»), и
 * держать здесь зелёную пробу значило бы врать о состоянии дерева.
 *
 * ЧТО ОСТАЁТСЯ КРАСНЫМ ЗДЕСЬ (С2, С3, К1) и ПОЧЕМУ это не «дописать», а решение владельца: срез по
 * значению, известному только в РАНТАЙМЕ, обязан считать КОДОВЫЕ ТОЧКИ, а смещение кодпоинта в байтах
 * для неизвестного содержимого невычислимо без ПРОХОДА по строке. Проход — это ЦИКЛ, цикл — это
 * ПЕРЕХОД, а переходы у цели существуют только как носители `src/e2k/twoPassLayout.ts`. Правка VLIW —
 * «стоп и доклад» (правило владельца), поэтому пробы ждут решения, а не «дочинивания».
 * Переезжает в `src/e2k/stringRuntimeSlice.test.ts` В ТОТ ЖЕ коммит, которым проба станет зелёной.
 *
 * ═══ ЧТО ЗДЕСЬ ЗАМЕРЯЕТСЯ (замер до кода — ЧАСТЬ ОТЧЁТА, а не только проверки) ══════════════════════
 *
 * ДВА СЛОЯ, и путать их нельзя:
 *
 *   • СЛОЙ «ЧТО ОБЯЗАНО СТАТЬ» (С2, С3, К1) — сегодня КРАСНЫЙ. Он и есть водитель работы:
 *     срез по РАНТАЙМОВОМУ индексу, срез по РАНТАЙМОВОЙ строке, склейка строки,
 *     длина которой сборке не известна. (С1 — срез по константам — СДЕЛАН и уехал в дерево.)
 *   • СЛОЙ «ЧЕГО НЕ ДОЛЖНО СЛУЧИТЬСЯ» (Б1, Б2) — сегодня ЗЕЛЁНЫЙ и обязан остаться: на месте
 *     сегодняшней стены ОБЯЗАН быть НАЗВАННЫЙ ОТКАЗ (код + операция), а не число и не мусор.
 *     Если проба Б1/Б2 когда-нибудь станет красной «0 отказов + неверный текст» — это ОДИННАДЦАТАЯ
 *     ТИХАЯ ЛОЖЬ проекта, и её надо докладывать владельцу, а не «дочинивать» молча.
 *
 * Запуск (нужен шлюз: числа спрашиваются только там, где модель обязана быть):
 *
 *   $env:OSNOVA_GATE_QEMU='1'; npx vitest run .tmp/td62-оракул.test.ts
 */
import * as fs from 'node:fs';
import * as path from 'node:path';
import { describe, expect, it } from 'vitest';
import { parseV3 } from '../src/compiler-v3/index';
import { loweredProgram } from '../src/e2k/lowered';
import { MINIMAL_BASE, WRITE_ZONE_EXTRA_MEMORY, buildElfFromCode } from '../src/e2k/elfMinimal';
import { buildShim, runInQemu } from '../src/scripts/e2kQemuExec';
import { SHIM_REASON } from '../src/scripts/e2kProgramRun';
import type { CompileOptions } from '../src/compiler/compiler';

const ROOT = path.resolve(__dirname, '..');
const ФАЙЛ = 'срез-и-склейка-рантайм.osnova';

// ── Пробы: СРЕЗ ───────────────────────────────────────────────────────────────────────────────────

/**
 * С2: срез, где НАЧАЛО И КОНЕЦ — рантаймовые (приходят параметрами с двух сайтов).
 * Сборка не знает ни индексов, ни, тем более, что за строка придёт.
 */
const С2_РАНТАЙМОВЫЕ_ИНДЕКСЫ = [
  'процедура резать(а: Строка, н: Число, к: Число) → Строка',
  '  вернуть подстрока(а, н, к)',
  'конец',
  '',
  'действие главная()',
  '  вывести резать("абвгде", 1, 3)',
  '  вывести резать("ёжзийк", 1, 3)',
  '  вернуть 0',
  'конец',
].join('\n');

/** С3: срез по РАНТАЙМОВОЙ строке (два разных сайта — значения сборке не известны). */
const С3_РАНТАЙМОВАЯ_СТРОКА = [
  'процедура резать(а: Строка) → Строка',
  '  вернуть подстрока(а, 1, 3)',
  'конец',
  '',
  'действие главная()',
  '  вывести резать("абвгде")',
  '  вывести резать("ёжзийк")',
  '  вернуть 0',
  'конец',
].join('\n');

/** ОБ1 — ГРАНИЦА: начало за концом. Здесь честны И отказ, И пустая строка, но НЕ мусор. */
const ОБ1_ПУСТОЙ_СРЕЗ = [
  'действие главная()',
  '  пусть с = "абвгде"',
  '  вывести подстрока(с, 3, 1)',
  '  вернуть 0',
  'конец',
].join('\n');

/** ОБ2 — ГРАНИЦА: конец за длиной. Честны отказ по имени ИЛИ усечение по длине, но не мусор. */
const ОБ2_КОНЕЦ_ЗА_ДЛИНОЙ = [
  'действие главная()',
  '  пусть с = "абвгде"',
  '  вывести подстрока(с, 2, 99)',
  '  вернуть 0',
  'конец',
].join('\n');

// ── Проба: СКЛЕЙКА с рантаймовой длиной ───────────────────────────────────────────────────────────

/**
 * К1: склейка значения, ДЛИНА КОТОРОГО СБОРКЕ НЕ ИЗВЕСТНА (приходит из вызова).
 *
 * Это ровно та граница, которую случай 75 назвал отказом: дескриптор TD-0001 даёт ЧИСЛО КОДПОИНТОВ и
 * адрес таблицы кодов, а копировать нужно БАЙТЫ, и копирование с рантаймовой длиной — это ЦИКЛ.
 */
const К1_СКЛЕЙКА_РАНТАЙМОВОЙ_ДЛИНЫ = [
  'процедура сшить() → Строка',
  '  вернуть "абв"',
  'конец',
  '',
  'действие главная()',
  '  пусть а = сшить()',
  '  пусть б = сшить()',
  '  вывести а + б',
  '  вернуть 0',
  'конец',
].join('\n');

// ── Помощники (те же, что у оракулов TD-0001 и случая 75: один источник правды о двери) ────────────

interface Отказ {
  readonly код: string;
  readonly причина: string;
  readonly шаг: number;
}

function фронтенд(источник: string): { readonly ошибки: readonly string[]; readonly options: CompileOptions } {
  const разбор = parseV3(источник, ФАЙЛ);
  return {
    ошибки: разбор.errors,
    options: { filename: ФАЙЛ, parse: () => ({ ast: разбор.program ?? null, errors: разбор.errors }) },
  };
}

function отказы(источник: string): readonly Отказ[] {
  const { ошибки, options } = фронтенд(источник);
  expect(ошибки, 'разбор обязан быть чист: иначе проба не про понижение').toEqual([]);
  if (ошибки.length > 0) return [];
  let итог: ReturnType<typeof loweredProgram>;
  try {
    итог = loweredProgram(источник, options);
  } catch (беда) {
    return [{ код: 'БРОСОК', причина: беда instanceof Error ? беда.message : String(беда), шаг: -1 }];
  }
  if (итог.ок) return [];
  return итог.отказ.отказы.map((запись) => ({ код: запись.код, причина: запись.причина, шаг: запись.шаг }));
}

function названные(записи: readonly Отказ[]): readonly string[] {
  return записи.map((запись) => `${запись.код}: ${запись.причина}`);
}

let шимСобран: string | undefined;
let шимСпрошен = false;
function шим(): string | undefined {
  if (!шимСпрошен) {
    шимСпрошен = true;
    шимСобран = buildShim();
  }
  return шимСобран;
}

/**
 * Прогон пробы. Отказ понижения здесь НЕ бросок, а ЗНАЧЕНИЕ: половина проб сегодня именно отказывает,
 * и «отказ вместо текста» — это замер, который надо напечатать, а не упасть на нём.
 */
function прогон(имя: string, источник: string): { readonly вывод: string; readonly код: number | null; readonly отказ: string } {
  const { options } = фронтенд(источник);
  const итог = loweredProgram(источник, options);
  if (!итог.ок) {
    return { вывод: '', код: null, отказ: названные(отказы(источник)).join(' | ') };
  }
  const файлШима = шим();
  if (файлШима === undefined) throw new Error(SHIM_REASON);
  const elf = path.join(ROOT, '.tmp', `td62-${имя}.elf`);
  fs.mkdirSync(path.dirname(elf), { recursive: true });
  fs.writeFileSync(
    elf,
    buildElfFromCode(итог.значение.bytes, MINIMAL_BASE, { writable: true, extraMemory: WRITE_ZONE_EXTRA_MEMORY }).bytes,
  );
  const исполнение = runInQemu(elf, { shim: true, timeoutMs: 30_000 });
  return {
    вывод: (исполнение?.stdout ?? '').replace(/\n$/u, ''),
    код: исполнение?.status ?? null,
    отказ: '',
  };
}

/** Признак шлюза: числа спрашиваются ТОЛЬКО там, где модель обязана быть (случай 12 реестра). */
const В_ШЛЮЗЕ_QEMU = process.env.OSNOVA_GATE_QEMU === '1';

// ── СЛОЙ «ЧЕГО НЕ ДОЛЖНО СЛУЧИТЬСЯ»: сегодня ЗЕЛЁНЫЙ, обязан остаться ─────────────────────────────

describe('ATOM-06-02-02: стена НАЗВАНА — не число и не мусор', () => {
  it('Б1: срез, которого нет, — НАЗВАННЫЙ отказ (код + операция), а не адрес', () => {
    const текст = названные(отказы(С2_РАНТАЙМОВЫЕ_ИНДЕКСЫ)).join(' | ');
    console.log(`[06-02] Б1 (срез по рантаймовым индексам): ${текст === '' ? 'ОТКАЗОВ НЕТ — проба собралась' : текст}`);
    if (текст === '') return; // собралось — тогда слово за водителем С2 ниже
    expect(текст, 'отказ обязан назвать ОПЕРАЦИЮ: иначе он неотличим от чужого').toContain('система.строка');
    expect(текст, 'и код контракта').toContain('OSN-LOW-003');
  });

  it('Б2: склейка с рантаймовой длиной — НАЗВАННЫЙ отказ ИЛИ верный текст, но не мусор', () => {
    const итог = прогон('б2-склейка-рантайм', К1_СКЛЕЙКА_РАНТАЙМОВОЙ_ДЛИНЫ);
    const текстом = итог.отказ === '' ? `текст «${итог.вывод}»` : `отказ: ${итог.отказ}`;
    console.log(`[06-02] Б2 (склейка рантаймовой длины): ${текстом}`);
    if (итог.отказ === '') {
      // Собралось — значит ОБЯЗАНО быть верно: «абв» + «абв».
      expect(итог.вывод, 'собралось, но текст неверный — это ТИХАЯ ЛОЖЬ, а не долг').toBe('абвабв');
      return;
    }
    expect(итог.отказ).toContain('система.строка.объединить');
  });

  it('ОБ1/ОБ2: границы среза — отказ по имени ИЛИ честное значение, а не мусор', () => {
    for (const [имя, источник] of [
      ['ОБ1 (начало за концом)', ОБ1_ПУСТОЙ_СРЕЗ],
      ['ОБ2 (конец за длиной)', ОБ2_КОНЕЦ_ЗА_ДЛИНОЙ],
    ] as const) {
      const записи = отказы(источник);
      const текст = названные(записи).join(' | ');
      console.log(`[06-02] ${имя}: ${текст === '' ? 'отказов нет (образ собран)' : текст}`);
      if (текст !== '') expect(текст, 'отказ обязан быть назван по коду').toContain('OSN-LOW-');
    }
  });
});

// ── СЛОЙ «ЧТО ОБЯЗАНО СТАТЬ»: сегодня КРАСНЫЙ, это и есть водитель работы ─────────────────────────

describe('ATOM-06-02-02 (ВОДИТЕЛЬ, сегодня красный): срез и склейка рантаймовых строк', () => {
  it('С2: срез по РАНТАЙМОВЫМ индексам — «бв» и «жз»', () => {
    if (!В_ШЛЮЗЕ_QEMU) return;
    const итог = прогон('с2-индексы', С2_РАНТАЙМОВЫЕ_ИНДЕКСЫ);
    expect(итог.отказ, 'индексы из параметров — это уже рантайм, но срез обязан работать').toBe('');
    expect(итог.вывод, '«абвгде»[1..3] = «бв», «ёжзийк»[1..3] = «жз»').toBe('бв\nжз');
    expect(итог.код).toBe(0);
  });

  it('С3: срез по РАНТАЙМОВОЙ строке (два сайта) — тот же текст', () => {
    if (!В_ШЛЮЗЕ_QEMU) return;
    const итог = прогон('с3-строка', С3_РАНТАЙМОВАЯ_СТРОКА);
    expect(итог.отказ, 'строка приходит из вызова — значение сборке не известно').toBe('');
    expect(итог.вывод).toBe('бв\nжз');
    expect(итог.код).toBe(0);
  });

  it('К1: склейка значения, длина которого сборке НЕ ИЗВЕСТНА — «абвабв»', () => {
    if (!В_ШЛЮЗЕ_QEMU) return;
    const итог = прогон('к1-склейка', К1_СКЛЕЙКА_РАНТАЙМОВОЙ_ДЛИНЫ);
    expect(итог.отказ, 'склейка двух значений из вызова').toBe('');
    expect(итог.вывод, '«абв» + «абв»').toBe('абвабв');
    expect(итог.код).toBe(0);
  });
});

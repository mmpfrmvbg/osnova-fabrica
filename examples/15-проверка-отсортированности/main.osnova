процедура главная()
  пусть числа = [1, 3, 3, 7]
  пусть нарушений = 0
  пусть индекс = 1
  пока индекс < система.массив.длина(числа)
    если система.массив.получить(числа, индекс - 1) > система.массив.получить(числа, индекс)
      нарушений = нарушений + 1
    конец_если
    индекс = индекс + 1
  конец_пока
  вернуть нарушений
конец_процедуры

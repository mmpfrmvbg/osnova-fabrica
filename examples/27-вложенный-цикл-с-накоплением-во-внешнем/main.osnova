процедура главная()
  пусть числа = [1, 2, 3]
  пусть итог = 0
  пусть внешний = 0
  пока внешний < система.массив.длина(числа)
    пусть внутренний = 0
    пока внутренний < система.массив.длина(числа)
      итог = итог + система.массив.получить(числа, внешний) * система.массив.получить(числа, внутренний)
      внутренний = внутренний + 1
    конец_пока
    внешний = внешний + 1
  конец_пока
  вернуть итог
конец_процедуры

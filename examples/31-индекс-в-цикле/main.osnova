процедура главная()
  пусть числа = [3, 9, 4, 7]
  пусть максимум = система.массив.получить(числа, 0)
  пусть место = 1
  пусть индекс = 1
  пока индекс < система.массив.длина(числа)
    пусть значение = система.массив.получить(числа, индекс)
    если значение > максимум
      максимум = значение
      место = индекс + 1
    конец_если
    индекс = индекс + 1
  конец_пока
  вернуть место
конец_процедуры

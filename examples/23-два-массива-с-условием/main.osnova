процедура главная()
  пусть а = [1, 5, 3, 8]
  пусть б = [2, 4, 6, 1]
  пусть итог = 0
  пусть индекс = 0
  пока индекс < система.массив.длина(а)
    если система.массив.получить(а, индекс) > система.массив.получить(б, индекс)
      итог = итог + система.массив.получить(а, индекс)
    иначе
      итог = итог + система.массив.получить(б, индекс)
    конец_если
    индекс = индекс + 1
  конец_пока
  вернуть итог
конец_процедуры

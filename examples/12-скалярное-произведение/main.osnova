процедура главная()
  пусть а = [1, 2, 3, 4]
  пусть б = [5, 6, 7, 8]
  пусть произведение = 0
  пусть индекс = 0
  пока индекс < система.массив.длина(а)
    произведение = произведение + система.массив.получить(а, индекс) * система.массив.получить(б, индекс)
    индекс = индекс + 1
  конец_пока
  вернуть произведение
конец_процедуры

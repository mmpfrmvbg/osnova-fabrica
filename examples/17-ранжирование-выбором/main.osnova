процедура главная()
  пусть числа = [4, 1, 3, 2]
  пусть контроль = 0
  пусть индекс = 0
  пока индекс < система.массив.длина(числа)
    пусть место = 1
    пусть другой = 0
    пока другой < система.массив.длина(числа)
      если система.массив.получить(числа, другой) < система.массив.получить(числа, индекс)
        место = место + 1
      конец_если
      другой = другой + 1
    конец_пока
    контроль = контроль + место * (индекс + 1)
    индекс = индекс + 1
  конец_пока
  вернуть контроль
конец_процедуры

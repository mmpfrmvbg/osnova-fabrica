процедура главная()
  пусть а = [1, 2]
  пусть б = [3, 4]
  пусть третий_массив = [5, 6]
  пусть итог = 0
  пусть первый = 0
  пока первый < система.массив.длина(а)
    итог = итог + система.массив.получить(а, первый)
    первый = первый + 1
  конец_пока
  пусть второй = 0
  пока второй < система.массив.длина(б)
    итог = итог + система.массив.получить(б, второй)
    второй = второй + 1
  конец_пока
  пусть третий = 0
  пока третий < система.массив.длина(третий_массив)
    итог = итог + система.массив.получить(третий_массив, третий)
    третий = третий + 1
  конец_пока
  вернуть итог
конец_процедуры

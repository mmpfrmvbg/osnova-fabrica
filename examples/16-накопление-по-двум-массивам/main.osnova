процедура главная()
  пусть а = [1, 2, 3, 4]
  пусть б = [5, 6, 7, 8]
  пусть итог = 0
  пусть индекс = 0
  пока индекс < система.массив.длина(а)
    итог = итог + система.массив.получить(а, индекс) * система.массив.получить(б, система.массив.длина(б) - 1 - индекс)
    индекс = индекс + 1
  конец_пока
  вернуть итог
конец_процедуры

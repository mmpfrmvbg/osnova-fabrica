процедура главная()
  пусть числа = [3, 5, 2, 0 - 1, 7]
  пусть сумма = 0
  пусть индекс = 0
  пока индекс < система.массив.длина(числа) и система.массив.получить(числа, индекс) > 0
    сумма = сумма + система.массив.получить(числа, индекс)
    индекс = индекс + 1
  конец_пока
  вернуть сумма
конец_процедуры

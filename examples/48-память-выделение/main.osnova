процедура шаг(значение: Число): Число
  вернуть значение
конец_процедуры

процедура главная()
  пусть предыдущий = система.память.выделить(16)
  пусть индекс = 0
  пока индекс < 4
    пусть текущий = система.память.выделить(16)
    система.лог.вывести(шаг(текущий - предыдущий))
    предыдущий = текущий
    индекс = индекс + 1
  конец_пока
конец_процедуры

процедура главная()
  пусть числа = [4, 7, 2, 9]
  пусть сумма = 0
  пусть сумма_квадратов = 0
  пусть индекс = 0
  пока индекс < система.массив.длина(числа)
    пусть значение = система.массив.получить(числа, индекс)
    сумма = сумма + значение
    сумма_квадратов = сумма_квадратов + значение * значение
    индекс = индекс + 1
  конец_пока
  вернуть сумма * 100 + сумма_квадратов
конец_процедуры

процедура главная()
  пусть а = [1, 2, 3]
  пусть б = [4, 5]
  пусть итог = 0
  пусть индекс = 0
  пока индекс < система.массив.длина(а) + система.массив.длина(б)
    если индекс < система.массив.длина(а)
      итог = итог + система.массив.получить(а, индекс)
    иначе
      итог = итог + система.массив.получить(б, индекс - система.массив.длина(а))
    конец_если
    индекс = индекс + 1
  конец_пока
  вернуть итог
конец_процедуры

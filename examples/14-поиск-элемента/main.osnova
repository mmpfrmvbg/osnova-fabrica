процедура главная()
  пусть числа = [10, 20, 30, 40]
  пусть искомое = 30
  пусть место = 0
  пусть индекс = 0
  пока индекс < система.массив.длина(числа)
    если система.массив.получить(числа, индекс) = искомое
      место = индекс + 1
    конец_если
    индекс = индекс + 1
  конец_пока
  вернуть место
конец_процедуры

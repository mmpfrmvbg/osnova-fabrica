процедура главная()
  пусть числа = [4, 7, 2, 9]
  пусть сумма = 0
  пусть остаток = 1000
  пусть индекс = 0
  пока индекс < система.массив.длина(числа)
    пусть значение = система.массив.получить(числа, индекс)
    сумма = сумма + значение
    остаток = остаток - значение
    индекс = индекс + 1
  конец_пока
  вернуть остаток - сумма
конец_процедуры

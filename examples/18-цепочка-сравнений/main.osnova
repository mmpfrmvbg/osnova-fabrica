процедура главная()
  пусть числа = [2, 5, 7, 9]
  пусть внутри = 0
  пусть индекс = 0
  пока индекс < система.массив.длина(числа)
    пусть значение = система.массив.получить(числа, индекс)
    если 4 < значение < 8
      внутри = внутри + 1
    конец_если
    индекс = индекс + 1
  конец_пока
  вернуть внутри
конец_процедуры

процедура главная()
  пусть числа = [1, 12, 3, 20]
  пусть итог = 0
  пусть индекс = 0
  пока индекс < система.массив.длина(числа)
    пусть значение = система.массив.получить(числа, индекс)
    если значение > 10
      если значение > 15
        итог = итог + 100
      иначе
        итог = итог + 10
      конец_если
    конец_если
    индекс = индекс + 1
  конец_пока
  вернуть итог
конец_процедуры

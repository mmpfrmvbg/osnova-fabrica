процедура главная()
  пусть числа = [3, 1, 4, 1, 5]
  пусть сумма = 0
  пусть индекс = 0
  пока индекс < система.массив.длина(числа)
    пусть значение = система.массив.получить(числа, индекс)
    сумма = сумма + значение * значение
    индекс = индекс + 1
  конец_пока
  вернуть сумма
конец_процедуры

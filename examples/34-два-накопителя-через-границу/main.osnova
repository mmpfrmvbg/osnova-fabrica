процедура главная()
  пусть а = [1, 2, 3]
  пусть б = [4, 1, 0]
  пусть сумма_а = 0
  пусть сумма_б = 0
  пусть первый = 0
  пока первый < система.массив.длина(а)
    сумма_а = сумма_а + система.массив.получить(а, первый)
    первый = первый + 1
  конец_пока
  пусть второй = 0
  пока второй < система.массив.длина(б)
    сумма_б = сумма_б + система.массив.получить(б, второй)
    второй = второй + 1
  конец_пока
  вернуть сумма_а * 10 + сумма_б
конец_процедуры

процедура главная()
  пусть числа = [7, 3, 9, 2, 8]
  пусть минимум = система.массив.получить(числа, 0)
  пусть индекс = 1
  пока индекс < система.массив.длина(числа)
    пусть текущее = система.массив.получить(числа, индекс)
    если текущее < минимум
      минимум = текущее
    конец_если
    индекс = индекс + 1
  конец_пока
  вернуть минимум
конец_процедуры

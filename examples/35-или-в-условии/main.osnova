процедура главная()
  пусть числа = [5, 1, 9, 5]
  пусть найдено = 0
  пусть индекс = 0
  пока индекс < система.массив.длина(числа)
    пусть значение = система.массив.получить(числа, индекс)
    если значение = 5 или значение = 9
      найдено = найдено + 1
    конец_если
    индекс = индекс + 1
  конец_пока
  вернуть найдено
конец_процедуры

процедура главная()
  пусть числа = [1, 3, 9, 7]
  пусть ответ = 0
  пусть индекс = 0
  пока индекс < система.массив.длина(числа)
    пусть значение = система.массив.получить(числа, индекс)
    если значение > 5
      ответ = значение
      прервать
    конец_если
    индекс = индекс + 1
  конец_пока
  вернуть ответ
конец_процедуры

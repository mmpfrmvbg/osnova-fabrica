процедура главная()
  пусть а = [1, 2, 3]
  пусть б = [4, 1, 0]
  пусть сумма_а = 0
  пусть сумма_б = 0
  пусть индекс = 0
  пока индекс < система.массив.длина(а)
    сумма_а = сумма_а + система.массив.получить(а, индекс)
    сумма_б = сумма_б + система.массив.получить(б, индекс)
    индекс = индекс + 1
  конец_пока
  если сумма_а > сумма_б
    вернуть 1
  конец_если
  вернуть 0
конец_процедуры

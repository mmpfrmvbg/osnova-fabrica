            "type": "Stmt[]"
          },
          {
            "name": "elseBody",
            "type": "Stmt[]",
            "optional": true
          }
        ]
      },
      "since": "0.1.0",
      "bytecodePattern": "condition → jmp_if_not else; then-body; jmp end; else-body; end:",
      "implemented": true
    },
    {
      "id": "while",
      "syntax": "пока <условие> ... конец",
      "astNode": {
        "kind": "пока",
        "fields": [
